---
import '../styles/global.css';
import Header from '../components/Header.astro';
import SectionRail from '../components/SectionRail.astro';
import Footer from '../components/Footer.astro';
import Palette from '../components/Palette.astro';
import { getPieces, AUTHOR } from '../lib/pieces';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  rail?: boolean;
  fullTitle?: string;
  noindex?: boolean;
  crumbs?: { name: string; href: string }[];
  faq?: { q: string; a: string }[];
}
const { title, description = `A free UI design skill for AI coding agents, with hundreds of live design ideas: sections, app screens, palettes, font pairings and motion.`, ogImage, bodyClass, rail = true, noindex = false, crumbs, faq } = Astro.props;
// Search results show about 155 characters: keep whole sentences that fit, else cut at a word.
const clip = (s: string, max = 158) => {
  if (s.length <= max) return s;
  const head = s.slice(0, max);
  const stop = Math.max(head.lastIndexOf('. '), head.lastIndexOf('? '), head.lastIndexOf('! '));
  return stop > 80 ? head.slice(0, stop + 1) : head.slice(0, head.lastIndexOf(' ')).replace(/[,;:]$/, '') + '…';
};
const metaDescription = clip(description);
const fullTitle = Astro.props.fullTitle ?? (title ? `${title} · Design Lounge` : `Design Lounge`);
const origin = (Astro.site ?? new URL('https://www.designlounge.live')).toString().replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/index(\.html)?$/, '').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonical = path === '/' ? `${origin}/` : `${origin}${path}`;
const json = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c');
const person = { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.site, jobTitle: AUTHOR.role, sameAs: AUTHOR.links.map((l) => l.href) };
const graph: Record<string, unknown>[] = [
  path === '/'
    ? {
        '@type': 'WebSite',
        '@id': `${origin}/#website`,
        name: 'Design Lounge',
        alternateName: ['DesignLounge', 'Design Lounge by Susan Acharya', 'UI design skill for AI agents'],
        url: `${origin}/`,
        description,
        inLanguage: 'en',
        author: person,
        publisher: {
          '@type': 'Organization',
          name: 'Design Lounge',
          url: `${origin}/`,
          logo: { '@type': 'ImageObject', url: `${origin}/logo.png`, width: 1024, height: 1024 },
        },
        potentialAction: {
          '@type': 'SearchAction',
          target: { '@type': 'EntryPoint', urlTemplate: `${origin}/browse?q={search_term_string}` },
          'query-input': 'required name=search_term_string',
        },
      }
    : { '@type': 'WebPage', name: fullTitle, url: canonical, description, isPartOf: { '@type': 'WebSite', name: 'Design Lounge', url: `${origin}/` }, author: person },
];
if (crumbs?.length) graph.push({
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Design Lounge', href: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: `${origin}${c.href === '/' ? '/' : c.href}` })),
});
if (faq?.length) graph.push({
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const ld = json({ '@context': 'https://schema.org', '@graph': graph });
const count = (await getPieces()).length;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google-site-verification" content="dwb4XIYW4cSUSfS1zsKO5kKDHF7T0Na4AsGfq9nLZLg" />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="author" content={AUTHOR.name} />
  <meta property="og:site_name" content="Design Lounge" />
  <meta name="application-name" content="Design Lounge" />
  <meta name="apple-mobile-web-app-title" content="Design Lounge" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@n00dlehead" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  <link rel="alternate" type="application/json" href="/api/pieces.json" title="Design Lounge catalogue" />
  <script type="application/ld+json" set:html={ld}></script>
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content={path === '/' ? 'website' : 'article'} />
  <meta property="og:image" content={ogImage ?? `${origin}/og/home.jpg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImage ? fullTitle : `Design Lounge, ${count} design ideas`} />
  <meta name="twitter:image" content={ogImage ?? `${origin}/og/home.jpg`} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="theme-color" content="#fafaf9" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
  <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('dl-theme');
        if (t !== 'day' && t !== 'night') t = 'day';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'day'); }
    })();
  </script>
</head>
<body class={bodyClass} data-count={count}>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  {rail && <SectionRail />}
  <main id="main">
    <slot />
  </main>
  <Footer />
  <Palette />
  <script>
    import '../scripts/frame.ts';
    import '../scripts/site.ts';
  </script>
</body>
</html>

<style is:global>
  .skip { position: fixed; left: 16px; top: -60px; z-index: 1000; padding: 10px 14px; background: var(--ink); color: var(--paper); font-family: var(--mono); font-size: 12px; border-radius: var(--r); transition: top var(--t-fast); }
  .skip:focus { top: 12px; }
  main { position: relative; z-index: 1; }
</style>
