---
import '../styles/global.css';
import Header from '../components/Header.astro';
import SectionRail from '../components/SectionRail.astro';
import Footer from '../components/Footer.astro';
import Palette from '../components/Palette.astro';
import { getPieces, AUTHOR } from '../lib/pieces';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
  rail?: boolean;
  fullTitle?: string;
  noindex?: boolean;
  crumbs?: { name: string; href: string }[];
  faq?: { q: string; a: string }[];
}
const { title, description = `Design Lounge is a free UI design skill for AI coding agents, with hundreds of design ideas: website sections, app screens, palettes, font pairings, icons and motion.`, ogImage, bodyClass, rail = true, noindex = false, crumbs, faq } = Astro.props;
const fullTitle = Astro.props.fullTitle ?? (title ? `${title} · Design Lounge` : `Design Lounge`);
const origin = (Astro.site ?? new URL('https://designlounge.vercel.app')).toString().replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/index(\.html)?$/, '').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonical = path === '/' ? `${origin}/` : `${origin}${path}`;
const json = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c');
const person = { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.site, jobTitle: AUTHOR.role, sameAs: AUTHOR.links.map((l) => l.href) };
const graph: Record<string, unknown>[] = [
  path === '/'
    ? { '@type': 'WebSite', name: 'Design Lounge', alternateName: 'Design Lounge UI design skill', url: `${origin}/`, description, author: person, publisher: person }
    : { '@type': 'WebPage', name: fullTitle, url: canonical, description, isPartOf: { '@type': 'WebSite', name: 'Design Lounge', url: `${origin}/` }, author: person },
];
if (crumbs?.length) graph.push({
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Design Lounge', href: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: `${origin}${c.href === '/' ? '/' : c.href}` })),
});
if (faq?.length) graph.push({
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const ld = json({ '@context': 'https://schema.org', '@graph': graph });
const count = (await getPieces()).length;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="google-site-verification" content="dwb4XIYW4cSUSfS1zsKO5kKDHF7T0Na4AsGfq9nLZLg" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="author" content={AUTHOR.name} />
  <meta property="og:site_name" content={`Design Lounge by ${AUTHOR.name}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator" content="@n00dlehead" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  <link rel="alternate" type="application/json" href="/api/pieces.json" title="Design Lounge catalogue" />
  <script type="application/ld+json" set:html={ld}></script>
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={path === '/' ? 'website' : 'article'} />
  <meta property="og:image" content={ogImage ?? `${origin}/og/home.jpg`} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0c0c0e" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('dl-theme');
        if (t !== 'day' && t !== 'night') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'day'); }
    })();
  </script>
</head>
<body class={bodyClass} data-count={count}>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  {rail && <SectionRail />}
  <main id="main">
    <slot />
  </main>
  <Footer />
  <Palette />
  <script>
    import '../scripts/frame.ts';
    import '../scripts/site.ts';
  </script>
</body>
</html>

<style is:global>
  .skip { position: fixed; left: 16px; top: -60px; z-index: 1000; padding: 10px 14px; background: var(--ink); color: var(--paper); font-family: var(--mono); font-size: 12px; border-radius: var(--r); transition: top var(--t-fast); }
  .skip:focus { top: 12px; }
  main { position: relative; z-index: 1; }
</style>
