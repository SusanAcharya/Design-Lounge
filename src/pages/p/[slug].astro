---
import { render } from 'astro:content';
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import DeviceFrame from '../../components/DeviceFrame.astro';
import PieceCard from '../../components/PieceCard.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import PieceDetails from '../../components/PieceDetails.astro';
import UseIt from '../../components/UseIt.astro';
import { COLLECTIONS } from '../../data/collections';
import { SOURCES, studyPiece } from '../../data/website-list';
import { getPieces, numberMap, creditedSource, creditedBrief, demoUrl, PLATFORM_META, TYPE_META, STYLE_META, CATEGORY_META, bytes } from '../../lib/pieces';

export async function getStaticPaths() {
  const pieces = await getPieces();
  return pieces.map((p, i) => ({ params: { slug: p.id }, props: { piece: p, prev: pieces[(i - 1 + pieces.length) % pieces.length], next: pieces[(i + 1) % pieces.length] } }));
}
const { piece, prev, next } = Astro.props;
const all = await getPieces();
const nums = numberMap(all);
const n = nums.get(piece.id)!;
const d = piece.data;
const { Content, headings } = await render(piece);
const source = creditedSource(piece.id);
const brief = creditedBrief(piece, n);
const size = new TextEncoder().encode(source).length;
const pm = PLATFORM_META[d.platform];
const lines = source.split('\n').length;
const briefLines = brief.split('\n').length;
const inCollections = COLLECTIONS.filter((c) => c.pieces.includes(piece.id));
const studied = studyPiece(piece, SOURCES);
const related = (() => {
  const explicit = d.related.map((s) => all.find((p) => p.id === s)).filter(Boolean);
  const scored = all.filter((p) => p.id !== piece.id && !explicit.includes(p)).map((p) => {
    let s = 0;
    if (p.data.type === d.type) s += 3;
    if (p.data.platform === d.platform) s += 2;
    s += p.data.styles.filter((x) => (d.styles as string[]).includes(x)).length * 2;
    s += p.data.tags.filter((x) => d.tags.includes(x)).length * 2;
    return { p, s };
  }).sort((a, b) => b.s - a.s).map((x) => x.p);
  return [...explicit, ...scored].slice(0, 3);
})();
const toc = [
  { id: 'preview', label: 'Preview', depth: 2 },
  { id: 'use-it', label: 'Use it', depth: 2 },
  { id: 'brief', label: 'Brief', depth: 2 },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text, depth: 3 })),
];
const isWeb = pm.frame === 'web';
const og = existsSync(new URL(`../../../public/og/${piece.id}.jpg`, import.meta.url)) ? new URL(`/og/${piece.id}.jpg`, Astro.site).toString() : undefined;
const json = (s: string) => JSON.stringify(s).replace(/</g, '\\u003c');
---
<Base title={`${d.title} · ${CATEGORY_META[d.category].label}`} description={d.summary} ogImage={og} crumbs={[{ name: 'Floor', href: '/browse' }, { name: TYPE_META[d.type].label, href: `/rooms/${d.type}` }, { name: CATEGORY_META[d.category].label, href: `/sections/${d.category}` }, { name: d.title, href: `/p/${piece.id}` }]}>
  <div class="docs wrap" data-docs>
    <DocsSidebar pieces={all} current={piece.id} />

    <article class="doc">
      <header class="phead">
        <div class="toprow">
          <button class="btn sm ghost allbtn" type="button" data-ds-open aria-controls="all-pieces" aria-expanded="false">
            <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h10M4 18h16"/></svg><span>All pieces</span>
          </button>
          <nav class="crumbs mono" aria-label="Breadcrumb">
            <a href="/browse">Floor</a><span aria-hidden="true">/</span><a href={`/rooms/${d.type}`}>{TYPE_META[d.type].label}</a><span aria-hidden="true">/</span><a href={`/sections/${d.category}`}>{CATEGORY_META[d.category].label}</a>
          </nav>
          <div class="pnav">
            <a class="pn-link" href={`/p/${prev.id}`} data-prev title={prev.data.title} aria-label={`Prev: ${prev.data.title}`}><kbd aria-hidden="true">[</kbd><span>prev</span></a>
            <a class="pn-link" href={`/p/${next.id}`} data-next title={next.data.title} aria-label={`Next: ${next.data.title}`}><span>next</span><kbd aria-hidden="true">]</kbd></a>
          </div>
        </div>
        <p class="mono faint num nmark">Nº {n} <span>of {String(all.length).padStart(3, '0')}</span></p>
        <h1 class="display title reveal">{d.title}</h1>
        <p class="summary reveal" style="--d:60ms">{d.summary}</p>
        <div class="facts reveal" style="--d:120ms">
          <a class="chip" href={`/platforms/${d.platform}`}><span class="dot"></span>{pm.label}</a>
          <a class="chip" href={`/rooms/${d.type}`}>{TYPE_META[d.type].singular}</a>
          <a class="chip" href={`/sections/${d.category}`}>{CATEGORY_META[d.category].label}</a>
          {d.styles.map((s) => <a class="chip" href={`/styles/${s}`}>{STYLE_META[s].label}</a>)}
        </div>
      </header>

      <section class="sec" id="preview" aria-labelledby="h-preview">
        <div class="sec-head">
          <h2 class="sec-title" id="h-preview">Preview</h2>
          {isWeb && (
            <div class="seg" role="group" aria-label="Preview width" data-views>
              <button type="button" aria-pressed="true" data-view="desktop">Desktop</button>
              <button type="button" aria-pressed="false" data-view="tablet">Tablet</button>
              <button type="button" aria-pressed="false" data-view="phone">Phone</button>
            </div>
          )}
        </div>
        <div class="stage-card">
          <div class="stage-bar">
            <div class="l">
              <button class="btn sm ghost" type="button" data-replay aria-label="Replay" title="Replay"><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 3v6h6"/></svg><span data-label>Replay</span></button>
              <a class="btn sm ghost" href={demoUrl(piece.id)} target="_blank" rel="noopener" aria-label="Open full size" title="Open full size"><svg viewBox="0 0 24 24"><path d="M14 4h6v6M20 4l-9 9"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg><span>Open full size</span></a>
              <button class="btn sm ghost" type="button" data-stage-tall aria-pressed="false" aria-label="Taller stage" title="Taller stage"><svg viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg><span>Taller stage</span></button>
            </div>
            <div class="r mono faint num">{pm.w} × {pm.h} · {bytes(size)} · {lines} lines</div>
          </div>
          <div class="stage" data-stage>
            <DeviceFrame slug={piece.id} platform={d.platform} title={d.title} interactive eager />
          </div>
        </div>
      </section>

      <section class="sec" id="use-it" aria-labelledby="h-use">
        <div class="sec-head">
          <h2 class="sec-title" id="h-use">Use it</h2>
          <span class="mono faint">Free to use · credit appreciated</span>
        </div>
        <UseIt slug={piece.id} title={d.title} brief={brief} source={source} />
      </section>

      <section class="sec" id="brief" aria-labelledby="h-brief">
        <div class="sec-head">
          <h2 class="sec-title" id="h-brief">Brief</h2>
          <span class="mono faint num">{briefLines} lines</span>
        </div>
        <div class="prose brief"><Content /></div>
      </section>

      <div class="after">
        <PieceDetails data={d} class="wide below" />
        <div class="notes">
          <div class="note">
            <p class="eyebrow">Studied</p>
            <a class="studied" href={studied.source.url} target="_blank" rel="noopener">{studied.source.name}</a>
            <p>{studied.quiet ? 'A control. It studies this site for quiet, not for a show.' : studied.source.take}</p>
            <a class="more" href={`/sources#${studied.source.id}`}>All sources</a>
          </div>
          {inCollections.length > 0 && (
            <div class="note">
              <p class="eyebrow">On the shelves</p>
              <ul class="shelf-list">{inCollections.map((c) => <li><a href={`/collections/${c.slug}`}><span class="mono faint">{c.kicker}</span> {c.title}</a></li>)}</ul>
            </div>
          )}
        </div>
      </div>

      <section class="related" aria-labelledby="h-similar">
        <div class="section-head">
          <div><h2 class="display h3" id="h-similar">Similar</h2></div>
          <a class="more" href={`/sections/${d.category}`}>All {CATEGORY_META[d.category].label.toLowerCase()} →</a>
        </div>
        <div class="grid">
          {related.map((p, i) => <PieceCard piece={p!} n={nums.get(p!.id) || '000'} index={i} />)}
        </div>
      </section>

      <nav class="pn-big" aria-label="Previous and next piece">
        <a href={`/p/${prev.id}`}><span class="eyebrow">← Nº {nums.get(prev.id)}</span><span class="display h4">{prev.data.title}</span></a>
        <a href={`/p/${next.id}`} class="r"><span class="eyebrow">Nº {nums.get(next.id)} →</span><span class="display h4">{next.data.title}</span></a>
      </nav>
    </article>

    <aside class="aside" aria-label="On this page and details">
      <div class="aside-in">
        <OnThisPage items={toc} />
        <PieceDetails data={d} />
      </div>
    </aside>
  </div>

  <script type="application/json" id="brief-src" set:html={json(brief)}></script>

  <script>
    const docs = document.querySelector<HTMLElement>('[data-docs]');
    const setStick = () => {
      const rail = document.querySelector('.rail') || document.querySelector('.hdr');
      if (rail && docs) docs.style.setProperty('--stick', `${Math.round(rail.getBoundingClientRect().bottom)}px`);
    };
    setStick();
    addEventListener('resize', setStick);
    // stage controls
    type Frame = HTMLElement & { reload?: () => void; setView?: (v: string) => void };
    const frame = document.querySelector('[data-stage] lounge-frame') as Frame | null;
    document.querySelector('[data-replay]')?.addEventListener('click', () => frame?.reload?.());
    const tall = document.querySelector<HTMLButtonElement>('[data-stage-tall]');
    tall?.addEventListener('click', () => { const on = tall.getAttribute('aria-pressed') !== 'true'; tall.setAttribute('aria-pressed', String(on)); document.querySelector('[data-stage]')?.classList.toggle('tall', on); });
    const views = [...document.querySelectorAll<HTMLButtonElement>('[data-views] [data-view]')];
    views.forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.view!;
      views.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      if (!frame) return;
      frame.dataset.view = v;
      if (typeof frame.setView === 'function') frame.setView(v);
    }));
    // hex copy
    document.querySelectorAll<HTMLButtonElement>('[data-copy-hex]').forEach((b) => b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copyHex!); } catch {}
      b.classList.add('done'); setTimeout(() => b.classList.remove('done'), 1200);
    }));
  </script>
</Base>

<style>
  .docs { --max: 1560px; --stick: 111px; display: grid; grid-template-columns: 248px minmax(0, 1fr) 220px; gap: 0 48px; align-items: start; }
  .doc { grid-column: 2; min-width: 0; padding: 28px 0 0; }
  .aside { grid-column: 3; position: sticky; top: var(--stick); max-height: calc(100vh - var(--stick)); overflow-y: auto; scrollbar-width: none; padding: 26px 0 32px; }
  .aside::-webkit-scrollbar { display: none; }
  .aside-in { display: flex; flex-direction: column; gap: 28px; }
  .doc :global([id]) { scroll-margin-top: calc(var(--stick) + 20px); }

  .phead { display: flex; flex-direction: column; gap: 12px; padding-bottom: 36px; }
  .toprow { display: flex; align-items: center; gap: 14px; min-height: 32px; }
  .allbtn { display: none; }
  .crumbs { display: flex; gap: 8px; flex-wrap: wrap; color: var(--ink-3); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; min-width: 0; }
  .crumbs a:hover { color: var(--ink); }
  .crumbs span { color: var(--ink-3); }
  .pnav { margin-left: auto; display: flex; align-items: center; gap: 4px; flex: none; }
  .pn-link { font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); display: inline-flex; gap: 6px; align-items: center; padding: 4px 6px; border-radius: var(--r); }
  .pn-link:hover { color: var(--ink); background: var(--paper-2); }
  .nmark { margin-top: 18px; font-size: 12px; letter-spacing: .1em; }
  .nmark span { color: var(--ink-3); }
  .title { font-size: clamp(34px, 4vw, 56px); }
  .summary { font-size: 17px; line-height: 1.5; color: var(--ink-2); max-width: 62ch; text-wrap: pretty; }
  .facts { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }

  .sec { padding-top: 8px; margin-bottom: 64px; }
  .sec-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-bottom: 14px; margin-bottom: 18px; border-bottom: 1px solid var(--ink); }
  .sec-title { font-family: var(--display); font-size: 26px; letter-spacing: -0.02em; line-height: 1.1; font-variation-settings: "opsz" 36; }
  .sec-head > .mono { font-size: 12px; }

  .seg { display: inline-flex; padding: 2px; border: 1px solid var(--line-2); border-radius: 999px; background: var(--paper); }
  .seg button { height: 26px; padding: 0 12px; border-radius: 999px; font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); transition: color var(--t-fast), background-color var(--t-fast); }
  .seg button:hover { color: var(--ink); }
  .seg button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .seg button:focus-visible { outline-offset: 1px; }

  .stage-card { display: flex; flex-direction: column; gap: 10px; }
  .stage-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .stage-bar .l { display: flex; gap: 6px; flex-wrap: wrap; }
  .stage-bar .r { font-size: 12px; }
  .stage { height: min(70vh, 760px); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--paper-2); background-image: radial-gradient(var(--line-2) 1px, transparent 1px); background-size: 16px 16px; background-position: center; position: relative; transition: height var(--t-slow) var(--ease); }
  .stage.tall { height: max(90vh, 900px); }
  .stage :global(lounge-frame) { position: absolute; inset: 24px; }

  .brief :global(h1) { display: none; }
  .brief :global(h1 + blockquote) { margin-top: 0; }
  .brief :global(h2) { scroll-margin-top: calc(var(--stick) + 20px); }

  .after { display: flex; flex-direction: column; gap: 32px; margin: -16px 0 0; padding-top: 28px; border-top: 1px solid var(--line); }
  .after :global(.below) { display: none; }
  .notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; }
  .note { display: flex; flex-direction: column; gap: 6px; }
  .note .eyebrow { margin-bottom: 4px; }
  .note p:not(.eyebrow) { color: var(--ink-2); font-size: 14px; max-width: 52ch; }
  .studied { font-family: var(--display); font-size: 22px; letter-spacing: -0.02em; align-self: flex-start; }
  .studied:hover { text-decoration: underline; text-underline-offset: 4px; }
  .note .more { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; align-self: flex-start; margin-top: 4px; }
  .note .more:hover { text-decoration: underline; text-underline-offset: 3px; }
  .shelf-list li { padding: 4px 0; font-size: 14px; }
  .shelf-list a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .related { margin-top: 72px; }
  .related .grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .pn-big { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 64px 0 24px; border-top: 1px solid var(--ink); padding-top: 24px; }
  .pn-big a { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .pn-big a.r { text-align: right; align-items: flex-end; }
  .pn-big a:hover .h4 { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }

  @media (max-width: 1279.98px) {
    .docs { grid-template-columns: 232px minmax(0, 1fr); gap: 0 40px; }
    .aside { display: none; }
    .after :global(.below) { display: grid; }
  }
  @media (max-width: 1023.98px) {
    .docs { grid-template-columns: minmax(0, 1fr); }
    .doc { grid-column: 1; padding-top: 18px; }
    .allbtn { display: inline-flex; flex: none; }
    .toprow { flex-wrap: wrap; }
    .crumbs { order: 3; flex-basis: 100%; }
    .nmark { margin-top: 10px; }
  }
  @media (max-width: 640px) {
    .stage { height: 62vh; }
    .stage :global(lounge-frame) { inset: 12px; }
    .stage-bar .r { display: none; }
    .stage-bar .btn span { display: none; }
    .stage-bar .btn { width: 32px; padding: 0; }
    .summary { font-size: 16px; }
    .sec { margin-bottom: 48px; }
    .sec-title { font-size: 23px; }
    .pn-big .h4 { font-size: 17px; }
  }
</style>
