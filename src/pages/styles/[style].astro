---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Catalog from '../../components/Catalog.astro';
import { getPieces, STYLE_META, type Style } from '../../lib/pieces';

export async function getStaticPaths() {
  return Object.keys(STYLE_META).map((style) => ({ params: { style } }));
}
const style = Astro.params.style as Style;
const meta = STYLE_META[style];
const all = await getPieces();
const pieces = all.filter((p) => (p.data.styles as string[]).includes(style));
const others = Object.entries(STYLE_META).filter(([k]) => k !== style && all.some((p) => (p.data.styles as string[]).includes(k)));
---
<Base title={`${meta.label} style`} description={`${meta.label} pieces in the Design Lounge. ${meta.blurb}`}>
  <PageHead eyebrow="Style" title={meta.label} blurb={meta.blurb} count={pieces.length}>
    <nav class="rooms" aria-label="Other styles">
      <span class="eyebrow">Other styles</span>
      {others.map(([k, v]) => <a class="chip" href={`/styles/${k}`}>{v.label}</a>)}
    </nav>
  </PageHead>
  <div class="wrap">
    {pieces.length ? <Catalog pieces={pieces} all={all} lock={{ style }} /> : <p class="lede" style="padding:40px 0">Nothing in this style yet.</p>}
  </div>
</Base>

<style>
  .rooms { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 8px; }
  .rooms .eyebrow { margin-right: 6px; }
</style>
