---
import Base from '../layouts/Base.astro';
import DeviceFrame from '../components/DeviceFrame.astro';
import Showcase from '../components/Showcase.astro';
import AgentTerminal from '../components/AgentTerminal.astro';
import { getPieces, CATEGORY_META, about } from '../lib/pieces';
import { PAIRINGS } from '../data/type';
import { THEMES } from '../data/themes';
import { ICONS } from '../data/icons';
import { RECIPES } from '../data/motion';
import { STARTS } from '../data/starts';
import { AUTHOR } from '../lib/pieces';
import { EXAMPLES, PAIRS, SOLO, exampleUrl } from '../data/examples';
import { CALLS, tokensOf, typicalTokens, benchSummary } from '../data/benchmark';
import { ROWS, LOUNGE, RIVALS, CHECKED } from '../data/compare';
import mcp from '../../mcp/package.json';

const all = await getPieces();
const newest = [...all].reverse();
const byId = new Map(all.map((p) => [p.id, p]));
const featured = all.filter((p) => p.data.featured);
const pick = (platform: string) => featured.find((p) => p.data.platform === platform) ?? newest.find((p) => p.data.platform === platform);
const heroWeb = pick('web') ?? newest[0];
const heroPhone = pick('mobile-app') ?? pick('pwa') ?? pick('mobile-web');
const heroTablet = pick('tablet');

const saas = STARTS.find((s) => s.id === 'saas');
const lime = saas?.directions.find((d) => d.id === 'lime-engine');
const agentHero = byId.get(lime?.hero ?? 'hero-split-ui-stack') ?? byId.get('hero-split-ui-stack');

const typeCount = (t: string) => all.filter((p) => p.data.type === t).length;
const catCount = (c: string) => all.filter((p) => p.data.category === c).length;
const previewSection = byId.get('hero-search-marketplace') ?? newest.find((p) => p.data.type === 'section');
const previewScreen = byId.get('phone-wallet-cards') ?? newest.find((p) => p.data.platform === 'mobile-app');
const previewMotion = byId.get('webgl-shader-hero') ?? newest.find((p) => p.data.type === 'animation');
const componentCats = (['navigation', 'buttons', 'inputs', 'cards', 'overlays', 'charts', 'pickers', 'feedback'] as const).filter((c) => catCount(c) > 0);
const dialectNames = all
  .filter((p) => p.data.type === 'style')
  .map((p) => p.data.title.replace(/ design language kit$/i, '').replace(/ design style$/i, '').replace(/ style sheet$/i, '').replace(/ style$/i, '').replace(/ kit$/i, ''))
  .sort((a, b) => a.localeCompare(b));
const system = [
  { n: PAIRINGS.length, label: 'Type pairings', href: '/type' },
  { n: THEMES.length, label: 'Themes', href: '/themes' },
  { n: ICONS.length, label: 'Icons', href: '/icons' },
  { n: RECIPES.length, label: 'Motion recipes', href: '/motion' },
];
// The two sites the homepage shows under Built from one prompt.
const homeBuilt = ['meridian-no-7', 'key-01'].map((id) => SOLO.find((e) => e.id === id)).filter((e) => e !== undefined);
const pair = PAIRS[0];
const pairSides = pair ? [pair.a, pair.b].map((id) => EXAMPLES.find((e) => e.id === id)).filter((e) => e !== undefined) : [];
const installCmd = 'npx skills add SusanAcharya/Design-Lounge';
const mcpCmd = 'claude mcp add -s user design-lounge -- npx -y design-lounge-mcp@latest';
// The two ways in, for the switch above each install box. The MCP server is first: it is the skill plus tools.
const installModes = [
  { key: 'mcp', label: 'MCP server', cmd: mcpCmd, note: 'For Claude Code. It installs the skill too.', link: { href: '/agents', label: 'Cursor, Codex, ChatGPT' } },
  { key: 'skill', label: 'Skill', cmd: installCmd, note: 'Files your agent reads. Needs Node 22.20 or newer.', link: null },
];
const cost = (tool: string) => tokensOf(CALLS.find((c) => c.tool === tool)!.chars);
const k = (n: number) => `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k`;
const bench = benchSummary();
const flow = [
  { step: 'Ask', tools: ['start_design'], tokens: cost('start_design'), text: 'Say what you are making in plain words. It reads them and returns the plan: the product kind, the rules that must hold, and the calls to make next.' },
  { step: 'Lock a direction', tools: ['get_recipe', 'get_theme', 'get_pairing'], tokens: cost('get_recipe') + cost('get_theme') + cost('get_pairing'), text: 'One recipe, one palette as CSS tokens, one type pairing with sizes. Your agent stops inventing a purple gradient and a font.' },
  { step: 'Build from briefs', tools: ['get_piece'], tokens: cost('get_piece'), each: true, text: 'Each section comes from a live piece and its numeric brief: sizes, states, timing, the acceptance checks.' },
  { step: 'Review', tools: ['review_page'], tokens: cost('review_page'), text: 'It opens the page and fails what looks machine-made, then checks SEO, AEO and GEO. Your agent fixes the list and runs it again.' },
];
const markText = { yes: 'Yes', no: 'No', part: 'In part' } as const;
const faq = [
  { q: 'What is Design Lounge?', a: `Design Lounge is a free UI design skill for AI coding agents, plus a library of ${about(all.length)} design ideas: website sections, app screens, components and motion. Each one has a live demo and a written brief that an agent can build from.` },
  { q: 'How do I add the UI design skill to my agent?', a: `Add the MCP server, which installs the skill too and adds tools that show your agent each piece and check the page it built. In Claude Code, run ${mcpCmd}. Cursor, Codex, VS Code and Claude Desktop take npx -y design-lounge-mcp@latest in their MCP settings, and Claude.ai or ChatGPT can add https://www.designlounge.live/api/mcp as a connector. For the skill alone, run ${installCmd} in your project (it needs Node 22.20 or newer). Then ask for what you are making, such as a portfolio, a shop or a dashboard.` },
  { q: 'What does the skill do differently?', a: `It makes your agent design from a real library instead of its own defaults. For a product, it picks a theme, a font pairing, a radius and motion from the library, builds the screens from piece briefs, then opens the page and checks it for the usual signs of AI-made design. When you ask for spectacle, it builds one centrepiece made for your subject, with real light and depth, and holds the rest of the page to the same craft.` },
  { q: 'Is it free to use in my products?', a: 'Yes. The pieces, themes, type pairings and icons are free to use in your own products and client work. A small credit line is appreciated. Please do not republish the library itself as a library.' },
  { q: 'Where do the design ideas come from?', a: `Every piece is an original design with an invented brand. Some study the craft of public sites, such as Stripe or Linear, and those are listed on the Sources page. No piece copies another site's text, images or logo.` },
  { q: 'How many tokens does the Design Lounge MCP use?', a: `About ${k(typicalTokens())} tokens for a whole direction: the plan from start_design (about ${k(cost('start_design'))}), a recipe, a theme and a pairing (about ${k(cost('get_recipe') + cost('get_theme') + cost('get_pairing'))} together), three piece briefs (about ${k(cost('get_piece'))} each) and one review. The tool list itself is about ${k(cost('tools/list'))}. The Benchmark page has the builds it was measured on.` },
  { q: 'Should I use the MCP server or the skill?', a: 'The MCP server, if your agent supports MCP. It installs the skill too, and adds tools that show your agent a picture of each piece, search the library, and review the page it built. The skill alone is a folder of files your agent reads, for agents without MCP.' },
  { q: 'Which agents does it work with?', a: 'Claude Code, Cursor, Codex, VS Code, Windsurf and Claude Desktop through the npm package design-lounge-mcp. Claude.ai, ChatGPT and other clients that take a remote connector can use https://www.designlounge.live/api/mcp. Agents without MCP can install the skill with npx skills add SusanAcharya/Design-Lounge.' },
  { q: 'Does it work with React, Flutter or SwiftUI?', a: 'Yes. A brief describes the design in numbers, not in one framework, and the demo is plain HTML. Your agent rebuilds it in your stack: React, Vue, Svelte, Astro, React Native, Flutter, SwiftUI or Compose. It sits well on top of a component library such as shadcn/ui.' },
  { q: 'How is it different from shadcn/ui, Mobbin or 21st.dev?', a: 'Those give your agent components to install or screenshots to look at. Design Lounge gives it a direction: a palette, a type pairing and a page recipe that agree, live pieces with numeric briefs, and a review of the finished page for design, SEO, AEO and GEO. It works alongside them. The comparison on this page shows what each one covers.' },
  { q: 'What does the review check?', a: 'It checks design, SEO, AEO and GEO in one pass, and lists fails first. review_page fails the usual signs of AI-made design (gradient text, an icon over a title over a sentence three times, numbered eyebrows, glass everywhere, invented fonts), checks that the page keeps its locked kit, and scores SEO, AEO and GEO: titles, descriptions, headings, structured data, answers that a search or AI engine can quote. The local server also screenshots the page and runs accessibility checks.' },
  { q: 'Does the hosted MCP see my code?', a: 'Only what your agent sends it. Most tools take a few words and return library data. review_page on the hosted endpoint reads a public URL or the HTML you pass. Run the npm package locally if you would rather keep it on your machine: the library and thumbnails are bundled, nothing is sent to Design Lounge, and there is no tracking.' },
  { q: 'Who made Design Lounge?', a: `${AUTHOR.name}, a ${AUTHOR.role.toLowerCase()} based in ${AUTHOR.city}, Nepal.` },
];
---
<Base rail={false} fullTitle="Design Lounge: a UI design skill and design ideas for AI agents" description={`A free UI design skill for Cursor, Claude Code and Codex, with ${about(all.length)} live design ideas: sections, app screens, palettes, font pairings and motion.`} faq={faq}>
  <section class="hero wrap">
    <div class="hero-text">
      <h1 class="display h1 reveal">Give your AI agent <i>design taste.</i></h1>
      <p class="lede reveal" style="--d:80ms">A free UI design skill and a library of {about(all.length)} live design ideas. Your agent picks real type, colour and motion, then builds.</p>
      <div class="hero-cta reveal" style="--d:160ms">
        <div class="install" data-install>
          <div class="modes" role="group" aria-label="Install as">
            {installModes.map((m, i) => <button type="button" data-mode={m.key} aria-pressed={i === 0 ? 'true' : 'false'}>{m.label}</button>)}
          </div>
          <span class="cmd big">
            <span class="prompt mono" aria-hidden="true">$</span>
            <code id="hero-cmd" data-cmds={JSON.stringify(Object.fromEntries(installModes.map((m) => [m.key, m.cmd])))}>{installModes[0].cmd}</code>
            <button class="copy" type="button" data-copy="#hero-cmd"><span data-label>Copy</span></button>
          </span>
          {installModes.map((m, i) => <p class="cmd-note" data-note={m.key} hidden={i !== 0}>{m.note}{m.link && <> <a href={m.link.href}>{m.link.label} →</a></>}</p>)}
        </div>
        <a class="textlink" href="/browse">Browse the library <span aria-hidden="true">→</span></a>
      </div>
      <ul class="trust reveal" style="--d:240ms" aria-label="At a glance">
        <li>Free, no account</li>
        <li><a href="https://www.npmjs.com/package/design-lounge-mcp" rel="noopener">design-lounge-mcp v{mcp.version}</a></li>
        <li><a href="https://registry.modelcontextprotocol.io/v0/servers?search=design-lounge" rel="noopener">On the MCP Registry</a></li>
        <li><a href="https://github.com/SusanAcharya/Design-Lounge" rel="noopener">Source on GitHub</a></li>
      </ul>
    </div>
    <div class="hero-wall" aria-label="Featured pieces">
      {heroWeb && (
        <a class="wall-item web" href={`/p/${heroWeb.id}`}>
          <span class="sr-only">{heroWeb.data.title}</span>
          <DeviceFrame slug={heroWeb.id} platform={heroWeb.data.platform} title={heroWeb.data.title} eager />
        </a>
      )}
      {heroPhone && (
        <a class="wall-item phone" href={`/p/${heroPhone.id}`}>
          <span class="sr-only">{heroPhone.data.title}</span>
          <DeviceFrame slug={heroPhone.id} platform={heroPhone.data.platform} title={heroPhone.data.title} eager />
        </a>
      )}
      {heroTablet && (
        <a class="wall-item tablet" href={`/p/${heroTablet.id}`}>
          <span class="sr-only">{heroTablet.data.title}</span>
          <DeviceFrame slug={heroTablet.id} platform={heroTablet.data.platform} title={heroTablet.data.title} />
        </a>
      )}
    </div>
  </section>

  <section class="proof wrap" aria-labelledby="proof-h">
    <header class="proof-head">
      <h2 class="h4" id="proof-h">Same model, same prompts, with and without the Lounge</h2>
      <a class="textlink" href="/benchmark">See every build <span aria-hidden="true">→</span></a>
    </header>
    <dl class="figs">
      <div>
        <dt>Review fails, same prompts</dt>
        <dd><span class="fig num">{bench.failsWith} vs {bench.failsWithout}</span><span class="fig-note">Across {bench.builds} builds with the Lounge MCP and the same {bench.builds} without it: design, accessibility, SEO, AEO and GEO.</span></dd>
      </div>
      <div>
        <dt>Text below readable contrast</dt>
        <dd><span class="fig num">{bench.contrastWith} vs {bench.contrastWithout}</span><span class="fig-note">Elements under WCAG AA. Every build with the Lounge passed on every line.</span></dd>
      </div>
      <div>
        <dt>Accessibility score</dt>
        <dd><span class="fig num">{bench.a11yWith}</span><span class="fig-note">On every build with the Lounge, measured with axe in Chromium. {bench.a11yWithout} on average without it.</span></dd>
      </div>
      <div>
        <dt>Tokens for a whole direction</dt>
        <dd><span class="fig num">{k(typicalTokens())}</span><span class="fig-note">Plan, palette, type pairing, three piece briefs and a review, from the live MCP.</span></dd>
      </div>
    </dl>
  </section>

  <section class="lib wrap" aria-labelledby="lib-h">
    <header class="block-head">
      <h2 class="display h2" id="lib-h">A library your agent can actually use.</h2>
      <p class="lede">Every piece runs live, comes with a written brief, and is free to use in your products.</p>
    </header>
    <div class="bento">
      <a class="cell c-sections" href="/browse?type=section">
        <div class="cell-text">
          <h3 class="cell-h">Sections <span class="cell-n num">{typeCount('section')}</span></h3>
          <p>Heroes, pricing, footers, menus. The blocks a website is built from.</p>
        </div>
        {previewSection && <div class="cell-stage web"><DeviceFrame slug={previewSection.id} platform={previewSection.data.platform} title={previewSection.data.title} /></div>}
      </a>
      <a class="cell c-screens" href="/browse?type=screen">
        <div class="cell-text">
          <h3 class="cell-h">Screens <span class="cell-n num">{typeCount('screen')}</span></h3>
          <p>Whole pages and app screens, end to end.</p>
        </div>
        {previewScreen && <div class="cell-stage phone"><DeviceFrame slug={previewScreen.id} platform={previewScreen.data.platform} title={previewScreen.data.title} /></div>}
      </a>
      <a class="cell c-motion" href="/browse?type=animation">
        <div class="cell-text">
          <h3 class="cell-h">Animations <span class="cell-n num">{typeCount('animation')}</span></h3>
        </div>
        {previewMotion && <div class="cell-stage web small"><DeviceFrame slug={previewMotion.id} platform={previewMotion.data.platform} title={previewMotion.data.title} /></div>}
      </a>
      <a class="cell c-components" href="/browse?type=component">
        <div class="cell-text">
          <h3 class="cell-h">Components <span class="cell-n num">{typeCount('component')}</span></h3>
        </div>
        <ul class="tags">
          {componentCats.map((c) => <li>{CATEGORY_META[c].label}</li>)}
        </ul>
      </a>
      <a class="cell c-styles" href="/browse?type=style">
        <div class="cell-text">
          <h3 class="cell-h">Design languages <span class="cell-n num">{typeCount('style')}</span></h3>
          <p>Whole visual dialects shown as a kit.</p>
        </div>
        <ul class="style-words" aria-label="Design languages">
          {dialectNames.map((s) => <li>{s}</li>)}
        </ul>
      </a>
      <div class="cell c-more">
        <a href="/browse?type=layout"><span class="cell-h">Layouts <span class="cell-n num">{typeCount('layout')}</span></span></a>
        <a href="/browse?type=pattern"><span class="cell-h">Patterns <span class="cell-n num">{typeCount('pattern')}</span></span></a>
      </div>
      <div class="cell c-system">
        <h3 class="cell-h"><a href="/system">The system underneath <span aria-hidden="true">→</span></a></h3>
        <ul class="sys">
          {system.map((s) => (
            <li><a href={s.href}><span class="cell-n num">{s.n}</span><span>{s.label}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="skill wrap" id="agent" aria-labelledby="agent-h">
    <header class="block-head">
      <p class="eyebrow">How it works</p>
      <h2 class="display h2" id="agent-h">Say what you're making. It picks the rest.</h2>
      <p class="lede">The MCP server turns one sentence into a locked direction and a checked page, in four kinds of call. Each one costs a few thousand tokens, measured on the live server.</p>
    </header>
    <ol class="flow">
      {flow.map((f) => (
        <li>
          <b>{f.step}</b>
          <span class="flow-tools">{f.tools.map((t) => <code>{t}</code>)}</span>
          <span class="flow-text">{f.text}</span>
          <span class="flow-cost mono">≈ {k(f.tokens)} tokens{f.each ? ' each' : ''}</span>
        </li>
      ))}
    </ol>
    <div class="agent-grid">
      <AgentTerminal pieces={about(all.length)} pairings={about(PAIRINGS.length)} themes={about(THEMES.length)} />
      <div class="agent-result">
        <div class="agent-stage">
          {agentHero && <DeviceFrame slug={agentHero.id} platform={agentHero.data.platform} title={agentHero.data.title} interactive />}
        </div>
        {agentHero && (
          <p class="agent-cap">
            <span>The result: {agentHero.data.title}</span>
            <a href={`/p/${agentHero.id}`}>Open piece <span aria-hidden="true">→</span></a>
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="built wrap" aria-labelledby="built-h">
    <header class="built-head">
      <div>
        <p class="eyebrow">Examples</p>
        <h2 class="display h2" id="built-h">Built from one prompt.</h2>
      </div>
      <a class="textlink" href="/examples">All {EXAMPLES.length} sites <span aria-hidden="true">→</span></a>
    </header>
    <ol class="built-row">
      {homeBuilt.map((e) => (
        <li>
          <a href={exampleUrl(e)} class="built-card">
            <img src={`/built/${e.id}/cover.jpg`} alt={`${e.title}, built by an agent with the skill`} width="1280" height="800" loading="lazy" />
            <span class="built-cap"><b>{e.title}</b><span>{e.prompt}</span></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  {pair && pairSides.length === 2 && (
    <section class="pairs wrap" aria-labelledby="pairs-h">
      <header class="built-head">
        <div>
          <p class="eyebrow">Range</p>
          <h2 class="display h2" id="pairs-h">Same product, <i>different style.</i></h2>
          <p class="lede">Both by Design Lounge. One prompt, built twice, on two directions.</p>
        </div>
        <span class="textlinks"><a class="textlink" href="/examples/compare">Compare all {PAIRS.length} <span aria-hidden="true">→</span></a><a class="textlink" href="/examples/proof">With and without the skill <span aria-hidden="true">→</span></a></span>
      </header>
      <p class="pair-prompt"><span class="mono" aria-hidden="true">&gt;</span> {pair.prompt}</p>
      <ol class="pair-row">
        {pairSides.map((e, j) => (
          <li>
            <a href={exampleUrl(e)} class="built-card">
              <img src={`/built/${e.id}/cover.jpg`} alt={`${pair.title}, style ${j === 0 ? 'A' : 'B'}`} width="1280" height="800" loading="lazy" />
              <span class="built-cap"><b>Style {j === 0 ? 'A' : 'B'}</b><span>{e.what}</span></span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="cmp wrap" aria-labelledby="cmp-h">
    <header class="block-head">
      <p class="eyebrow">How it compares</p>
      <h2 class="display h2" id="cmp-h">A direction and a review, in one free MCP.</h2>
      <p class="lede">Other tools hand your agent components to install or screenshots to look at. Design Lounge gives it a palette, a pairing and pieces that agree, then reviews what it built.</p>
    </header>
    <div class="cmp-scroll" role="region" aria-labelledby="cmp-h" tabindex="0">
      <table class="cmp-table">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Feature</span></th>
            <th scope="col" class="us">Design Lounge</th>
            {RIVALS.map((r) => <th scope="col"><a href={r.href} rel="noopener">{r.name}</a></th>)}
          </tr>
        </thead>
        <tbody>
          {ROWS.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td class="us"><span class={`mk ${LOUNGE.marks[row.key]}`}>{markText[LOUNGE.marks[row.key]]}</span></td>
              {RIVALS.map((r) => <td><span class={`mk ${r.marks[row.key]}`}>{markText[r.marks[row.key]]}</span></td>)}
            </tr>
          ))}
          <tr class="price">
            <th scope="row">Price</th>
            <td class="us">{LOUNGE.price}</td>
            {RIVALS.map((r) => <td>{r.price}</td>)}
          </tr>
        </tbody>
      </table>
    </div>
    <p class="cmp-note mono">Checked {CHECKED} on each product's own pages. Something out of date? <a href="https://github.com/SusanAcharya/Design-Lounge/issues" rel="noopener">Open an issue</a>.</p>
  </section>

  <section class="feats wrap" aria-labelledby="feats-h">
    <header class="feats-head">
      <h2 class="display h2" id="feats-h">More than a gallery.</h2>
      <p class="lede">Every piece is something you can take. Around them sit the tools that tie a product together.</p>
      <a class="btn" href="/agents">How it works</a>
    </header>
    <div class="feats-body">
      <div class="fgroup">
        <h3 class="fgroup-h">In every piece</h3>
        <ul>
          <li><b>Live demo</b><span>Every control works, inside a real browser, phone or tablet frame.</span></li>
          <li><b>Brief</b><span>A written spec your agent builds from. One click to copy.</span></li>
          <li><b>Source</b><span>The HTML, credited and free to use in your own products.</span></li>
        </ul>
      </div>
      <div class="fgroup">
        <h3 class="fgroup-h">Around the pieces</h3>
        <ul>
          <li><a href="/start"><b>Start</b><span>Pick what you're making. Get a theme, a pairing and the pieces that fit.</span></a></li>
          <li><a href="/kit"><b>Kit</b><span>Compose a kind, a palette, a pairing and an icon family into one brief.</span></a></li>
          <li><a href="/system"><b>System</b><span>{about(PAIRINGS.length)} type pairings, {about(THEMES.length)} themes, icons and motion recipes.</span></a></li>
          <li><button type="button" data-open-palette><b>Search</b><span>Press <kbd>⌘K</kbd> anywhere to jump to any piece.</span></button></li>
          <li><a href="/llms.txt"><b>For agents</b><span>An llms.txt and a JSON catalogue, so tools can read the library directly.</span></a></li>
        </ul>
      </div>
    </div>
  </section>

  <Showcase
    id="phones"
    kicker="Phone apps"
    more={{ href: '/browse?platform=mobile-app', label: 'All phone screens' }}
    slugs={[
      { slug: 'phone-wallet-cards', label: 'Wallet cards' },
      { slug: 'phone-workout-timer', label: 'Workout timer' },
      { slug: 'phone-lesson-quiz', label: 'Lesson quiz' },
      { slug: 'phone-feed-posts', label: 'Social feed' },
      { slug: 'phone-order-tracking', label: 'Order tracking' },
    ]}
  >
    <Fragment slot="title">Tap through a few right here.</Fragment>
    Real app screens at 390 × 844. Lift a card, run the timer, answer the quiz. Each ships with the brief your agent builds from.
  </Showcase>

  <section class="faq wrap" aria-labelledby="faq-h">
    <div class="faq-head">
      <h2 class="display h2" id="faq-h">Questions</h2>
      <p class="lede">The short version of how the skill and the library work.</p>
    </div>
