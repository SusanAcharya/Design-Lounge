---
import Base from '../layouts/Base.astro';
import DeviceFrame from '../components/DeviceFrame.astro';
import PieceCard from '../components/PieceCard.astro';
import { COLLECTIONS, SHELF_GROUPS } from '../data/collections';
import { getPieces, numberMap, CATEGORY_GROUPS, CATEGORY_META, AUTHOR } from '../lib/pieces';
import { PAIRINGS } from '../data/type';
import { THEMES } from '../data/themes';
import { ICONS } from '../data/icons';
import { RECIPES } from '../data/motion';
import { STARTS, MAP } from '../data/starts';

const all = await getPieces();
const nums = numberMap(all);
const newest = [...all].reverse();
const featured = all.filter((p) => p.data.featured);
const pick = (platform: string) => featured.find((p) => p.data.platform === platform) ?? newest.find((p) => p.data.platform === platform);
const heroWeb = pick('web') ?? newest[0];
const heroPhone = pick('mobile-app') ?? pick('pwa') ?? pick('mobile-web');
const heroTablet = pick('tablet');
const fresh = newest.slice(0, 4);
const byId = new Map(all.map((p) => [p.id, p]));
const catCount = (c: string) => all.filter((p) => p.data.category === c).length;
const indexGroups = CATEGORY_GROUPS.map((g) => ({
  ...g,
  items: g.items.map((c) => ({ c, n: catCount(c), label: CATEGORY_META[c].label })).filter((i) => i.n > 0),
})).filter((g) => g.items.length);
const groupedShelves = SHELF_GROUPS.map((g) => ({
  ...g,
  items: g.slugs.map((s) => COLLECTIONS.find((c) => c.slug === s)).filter(Boolean),
}));
const libs = [
  { href: '/type', kicker: 'Type', title: 'Pairings', n: PAIRINGS.length, blurb: 'Display and text marriages that already work.' },
  { href: '/themes', kicker: 'Themes', title: 'Palettes', n: THEMES.length, blurb: 'Full token sets, not five hex chips.' },
  { href: '/icons', kicker: 'Icons', title: 'Lounge Icons', n: ICONS.length, blurb: 'One 24px stroke family. Copy the SVG.' },
  { href: '/motion', kicker: 'Motion', title: 'Recipes', n: RECIPES.length, blurb: 'Curves, durations, reduced-motion fallbacks.' },
];
---
<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow reveal">{String(all.length).padStart(3, '0')} live pieces · {PAIRINGS.length} pairings · {THEMES.length} themes</p>
      <h1 class="display h1"><span class="reveal" style="--d:60ms">Interfaces</span> <span class="reveal" style="--d:140ms">worth</span> <i class="reveal" style="--d:220ms">sitting with.</i></h1>
      <p class="lede reveal" style="--d:300ms">A design library by {AUTHOR.name}. System first — type, colour, icons, motion — then pieces arranged by name and by problem. Copy any of it. Hand the brief to your agent.</p>
      <div class="acts reveal" style="--d:380ms">
        <a class="btn primary" href="/kit">Compose a kit</a>
        <a class="btn ghost" href="/browse">Browse the floor</a>
      </div>
    </div>
    <div class="hero-wall reveal" style="--d:160ms" aria-label="Featured pieces">
      {heroWeb && (
      <a class="wall-item web" href={`/p/${heroWeb.id}`} aria-label={heroWeb.data.title}>
        <DeviceFrame slug={heroWeb.id} platform={heroWeb.data.platform} title={heroWeb.data.title} eager />
      </a>
      )}
      {heroPhone && (
        <a class="wall-item phone" href={`/p/${heroPhone.id}`} aria-label={heroPhone.data.title}>
          <DeviceFrame slug={heroPhone.id} platform={heroPhone.data.platform} title={heroPhone.data.title} eager />
        </a>
      )}
      {heroTablet && (
        <a class="wall-item tablet" href={`/p/${heroTablet.id}`} aria-label={heroTablet.data.title}>
          <DeviceFrame slug={heroTablet.id} platform={heroTablet.data.platform} title={heroTablet.data.title} />
        </a>
      )}
    </div>
  </section>

  <nav class="map wrap" aria-label="Library map">
    {MAP.map((m) => (
      <a href={m.href}>
        <span class="eyebrow">{m.kicker}</span>
        <span class="display h4">{m.title}</span>
        <span class="muted">{m.blurb}</span>
      </a>
    ))}
  </nav>

  <section class="section wrap needs">
    <div class="section-head">
      <div><span class="eyebrow">Start</span><h2 class="display h2">What are you <i>making</i>?</h2></div>
      <a class="more" href="/start">All recipes →</a>
    </div>
    <ol class="need-grid">
      {STARTS.map((s, i) => (
        <li class="reveal" style={`--d:${i * 40}ms`}>
          <a href={`/start#${s.id}`}>
            <span class="eyebrow">{s.kicker}</span>
            <span class="display h4">{s.title}</span>
            <span class="muted">{s.blurb}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap libs">
    <div class="section-head">
      <div><span class="eyebrow">System</span><h2 class="display h2">Lock the <i>grammar</i> first.</h2></div>
      <a class="more" href="/system">Open the system →</a>
    </div>
    <ol class="lib-grid">
      {libs.map((l, i) => (
        <li class="reveal" style={`--d:${i * 50}ms`}>
          <a href={l.href}>
            <span class="eyebrow">{l.kicker}</span>
            <span class="display h3">{l.title}</span>
            <span class="n mono num">{String(l.n).padStart(2, '0')}</span>
            <span class="muted">{l.blurb}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap idx">
    <div class="section-head">
      <div><span class="eyebrow">Index</span><h2 class="display h2">Find it <i>by name.</i></h2></div>
      <a class="more" href="/c">Full index →</a>
    </div>
    <div class="idx-cols">
      {indexGroups.map((g) => (
        <div>
          <p class="eyebrow">{g.label}</p>
          <ol>
            {g.items.map((i) => (
              <li><a href={`/c/${i.c}`}><span>{i.label}</span><span class="mono num faint">{String(i.n).padStart(2, '0')}</span></a></li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap shelves-home">
    <div class="section-head">
      <div><span class="eyebrow">Shelves</span><h2 class="display h2">Arranged by <i>problem.</i></h2></div>
      <a class="more" href="/collections">All {COLLECTIONS.length} →</a>
    </div>
    <div class="shelf-groups">
      {groupedShelves.map((g) => (
        <div>
          <p class="eyebrow">{g.label}</p>
          <p class="muted gblurb">{g.blurb}</p>
          <ol>
            {g.items.map((c) => (
              <li>
                <a href={`/collections/${c!.slug}`}>
                  <span class="mono faint">{c!.kicker}</span>
                  <span class="display h4">{c!.title}</span>
                  <span class="mono num faint">{String(c!.pieces.filter((s) => byId.has(s)).length).padStart(2, '0')}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap fresh">
    <div class="section-head">
      <div><span class="eyebrow">Fresh on the floor</span><h2 class="display h2">Latest <i>pieces</i></h2></div>
      <a class="more" href="/browse">All {all.length} →</a>
    </div>
    <div class="grid">
      {fresh.map((p, i) => <PieceCard piece={p} n={nums.get(p.id) || '000'} index={i} />)}
    </div>
  </section>

  <section class="section wrap how">
    <ol class="how-row">
      <li class="reveal"><span class="mono faint">01</span><h3 class="display h4">Name the job</h3><p>Compose a kit — website, product, or platform. Or open the index. Don’t scroll 153 cards hoping one feels right.</p></li>
      <li class="reveal" style="--d:60ms"><span class="mono faint">02</span><h3 class="display h4">Lock the system</h3><p>Pick a researched palette, a pairing, a component family. Both screens update. Then sit with the live pieces.</p></li>
      <li class="reveal" style="--d:120ms"><span class="mono faint">03</span><h3 class="display h4">Copy the brief</h3><p>The kit writes the MD. Palette, type, components, pieces. Paste it into your agent.</p></li>
    </ol>
  </section>

  <section class="section wrap seat">
    <h2 class="display h1">Take a <i>seat.</i></h2>
    <div class="acts">
      <a class="btn primary" href="/random" data-random>Show me something</a>
      <a class="btn ghost" href="/agents">For agents</a>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px; align-items: center; padding: clamp(40px, 6vw, 80px) 0 clamp(32px, 5vw, 48px); min-height: calc(100vh - var(--header-h) - 120px); }
  .hero-text { display: flex; flex-direction: column; gap: 24px; }
  .hero .h1 span, .hero .h1 i { display: inline-block; }
  .hero .acts { display: flex; gap: 10px; flex-wrap: wrap; }
  .hero-wall { position: relative; aspect-ratio: 1 / 0.96; }
  .wall-item { position: absolute; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--paper-2); overflow: hidden; transition: transform var(--t-slow) var(--ease-out), border-color var(--t-med), box-shadow var(--t-med); }
  .wall-item :global(lounge-frame) { position: absolute; inset: 12px; }
  .wall-item:hover { border-color: var(--ink-3); box-shadow: var(--shadow); z-index: 5; transform: translateY(-6px); }
  .wall-item.web { left: 0; top: 0; width: 76%; aspect-ratio: 16 / 10.5; }
  .wall-item.phone { right: 0; top: 16%; width: 28%; aspect-ratio: 9 / 19; }
  .wall-item.phone :global(lounge-frame) { inset: 6px; }
  .wall-item.tablet { left: 10%; top: 57%; width: 54%; aspect-ratio: 16 / 11.3; }

  .map { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ink); border-left: 1px solid var(--line); }
  .map a { display: flex; flex-direction: column; gap: 8px; padding: 22px 20px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); min-height: 140px; transition: background-color var(--t-med) var(--ease); }
  .map a:hover { background: var(--paper-2); }
  .map .muted { font-size: 13.5px; max-width: 28ch; text-wrap: pretty; }

  .need-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ink); border-left: 1px solid var(--line); }
  .need-grid a { display: flex; flex-direction: column; gap: 8px; padding: 24px 20px; min-height: 168px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: background-color var(--t-med) var(--ease); }
  .need-grid a:hover { background: var(--paper-2); }
  .need-grid .muted { font-size: 13.5px; max-width: 28ch; text-wrap: pretty; }

  .lib-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ink); border-left: 1px solid var(--line); }
  .lib-grid a { display: flex; flex-direction: column; gap: 10px; padding: 28px 24px; min-height: 200px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: background-color var(--t-med) var(--ease); }
  .lib-grid a:hover { background: var(--paper-2); }
  .lib-grid .n { font-size: 28px; color: var(--ink-3); margin-top: auto; }
  .lib-grid .muted { font-size: 14px; max-width: 28ch; text-wrap: pretty; }

  .idx-cols { display: grid; grid-template-columns: repeat(5, 1fr); gap: 28px 20px; }
  .idx-cols .eyebrow { padding-bottom: 10px; border-bottom: 1px solid var(--ink); margin-bottom: 8px; }
  .idx-cols a { display: flex; justify-content: space-between; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .idx-cols a:hover { color: var(--accent); }

  .shelf-groups { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .gblurb { font-size: 14px; max-width: 36ch; margin: 8px 0 16px; text-wrap: pretty; }
  .shelf-groups .eyebrow { padding-bottom: 10px; border-bottom: 1px solid var(--ink); }
  .shelf-groups li a { display: grid; grid-template-columns: 48px 1fr auto; gap: 12px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .shelf-groups li a:hover .h4 { text-decoration: underline; text-underline-offset: 4px; }

  .how { padding-block: 0; }
  .how-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; border-top: 1px solid var(--ink); padding-top: 28px; }
  .how-row li { display: flex; flex-direction: column; gap: 8px; }
  .how-row p { color: var(--ink-2); font-size: 14.5px; max-width: 32ch; text-wrap: pretty; }

  .seat { display: flex; flex-direction: column; align-items: center; gap: 28px; text-align: center; padding-bottom: 0; }
  .seat .acts { display: flex; gap: 10px; }

  @media (max-width: 1100px) {
    .idx-cols { grid-template-columns: repeat(3, 1fr); }
    .need-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .map, .lib-grid { grid-template-columns: repeat(2, 1fr); }
    .shelf-groups { grid-template-columns: 1fr; gap: 32px; }
    .how-row { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .map, .lib-grid, .need-grid, .idx-cols { grid-template-columns: 1fr; }
    .wall-item.tablet { display: none; }
    .wall-item.web { width: 74%; top: 0; }
    .wall-item.phone { width: 34%; top: 20%; }
    .hero-wall { aspect-ratio: 4 / 3; }
  }
</style>
