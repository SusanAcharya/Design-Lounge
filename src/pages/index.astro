</Base>

<script>
  // The install switch: one choice for both boxes on the page, remembered for the next visit.
  const boxes = [...document.querySelectorAll<HTMLElement>('[data-install]')];
  const choose = (mode: string) => {
    for (const box of boxes) {
      const code = box.querySelector<HTMLElement>('code[data-cmds]');
      const cmds = JSON.parse(code?.dataset.cmds || '{}');
      if (!cmds[mode]) continue;
      code!.textContent = cmds[mode];
      box.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
      box.querySelectorAll<HTMLElement>('[data-note]').forEach((n) => { n.hidden = n.dataset.note !== mode; });
    }
  };
  let saved = null;
  try { saved = localStorage.getItem('dl-install'); } catch {}
  if (saved) choose(saved);
  for (const box of boxes) box.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => {
    choose(b.dataset.mode!);
    try { localStorage.setItem('dl-install', b.dataset.mode!); } catch {}
  }));
</script>

