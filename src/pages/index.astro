---
import Base from '../layouts/Base.astro';
import DeviceFrame from '../components/DeviceFrame.astro';
import PieceCard from '../components/PieceCard.astro';
import Showcase from '../components/Showcase.astro';
import Annotate from '../components/Annotate.astro';
import AgentTerminal from '../components/AgentTerminal.astro';
import { COLLECTIONS, SHELF_GROUPS } from '../data/collections';
import { getPieces, numberMap, CATEGORY_GROUPS, CATEGORY_META, AUTHOR } from '../lib/pieces';
import { PAIRINGS } from '../data/type';
import { THEMES } from '../data/themes';
import { ICONS } from '../data/icons';
import { RECIPES } from '../data/motion';
import { SURFACES, STARTS, startsOn } from '../data/starts';
import { SOURCES } from '../data/website-list';

const all = await getPieces();
const nums = numberMap(all);
const newest = [...all].reverse();
const featured = all.filter((p) => p.data.featured);
const pick = (platform: string) => featured.find((p) => p.data.platform === platform) ?? newest.find((p) => p.data.platform === platform);
const heroWeb = pick('web') ?? newest[0];
const heroPhone = pick('mobile-app') ?? pick('pwa') ?? pick('mobile-web');
const heroTablet = pick('tablet');
const fresh = newest.slice(0, 4);
const saas = STARTS.find((s) => s.id === 'saas');
const lime = saas?.directions.find((d) => d.id === 'lime-engine');
const agentHero = all.find((p) => p.id === (lime?.hero ?? 'hero-split-ui-stack')) ?? all.find((p) => p.id === 'hero-split-ui-stack');
const byId = new Map(all.map((p) => [p.id, p]));
const catCount = (c: string) => all.filter((p) => p.data.category === c).length;
const indexGroups = CATEGORY_GROUPS.map((g) => ({
  ...g,
  items: g.items.map((c) => ({ c, n: catCount(c), label: CATEGORY_META[c].label })).filter((i) => i.n > 0),
})).filter((g) => g.items.length);
const groupedShelves = SHELF_GROUPS.map((g) => ({
  ...g,
  items: g.slugs.map((s) => COLLECTIONS.find((c) => c.slug === s)).filter(Boolean),
}));
const libs = [
  { href: '/type', title: 'Type', n: PAIRINGS.length },
  { href: '/themes', title: 'Themes', n: THEMES.length },
  { href: '/icons', title: 'Icons', n: ICONS.length },
  { href: '/motion', title: 'Motion', n: RECIPES.length },
];
---
<Base>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow reveal">{String(all.length).padStart(3, '0')} live pieces · {PAIRINGS.length} pairings · {THEMES.length} themes</p>
      <h1 class="display h1"><span class="reveal" style="--d:60ms">Interfaces</span> <span class="reveal" style="--d:140ms">worth</span> <i class="reveal" style="--d:220ms">sitting with.</i></h1>
      <p class="lede reveal" style="--d:300ms">Add Design Lounge to your AI agent. Ask for a website or an app, and get one that stands out: real type, colour, and motion. Not a template.</p>
      <div class="install reveal" style="--d:380ms">
        <span class="cmd big">
          <span class="prompt mono" aria-hidden="true">$</span>
          <code id="hero-cmd">npx skills add SusanAcharya/Design-Lounge</code>
          <button class="copy" type="button" data-copy="#hero-cmd"><span data-label>Copy</span></button>
        </span>
        <p class="works mono faint">Cursor · Claude Code · Codex · free · <a href="/agents">How it works</a></p>
      </div>
      <div class="acts reveal" style="--d:440ms">
        <a class="btn ghost" href="/browse">See the designs</a>
        <a class="btn ghost" href="/start">Pick what you're making</a>
      </div>
    </div>
    <div class="hero-wall reveal" style="--d:160ms" aria-label="Featured pieces">
      {heroWeb && (
      <a class="wall-item web" href={`/p/${heroWeb.id}`} aria-label={heroWeb.data.title}>
        <DeviceFrame slug={heroWeb.id} platform={heroWeb.data.platform} title={heroWeb.data.title} eager />
      </a>
      )}
      {heroPhone && (
        <a class="wall-item phone" href={`/p/${heroPhone.id}`} aria-label={heroPhone.data.title}>
          <DeviceFrame slug={heroPhone.id} platform={heroPhone.data.platform} title={heroPhone.data.title} eager />
        </a>
      )}
      {heroTablet && (
        <a class="wall-item tablet" href={`/p/${heroTablet.id}`} aria-label={heroTablet.data.title}>
          <DeviceFrame slug={heroTablet.id} platform={heroTablet.data.platform} title={heroTablet.data.title} />
        </a>
      )}
    </div>
  </section>

  <section class="wrap agent" id="agent" aria-labelledby="agent-h">
    <div class="agent-head">
      <p class="sc-n mono"><span>Nº 01</span><span class="rule" aria-hidden="true"></span><span>Agent at work</span></p>
      <h2 class="display agent-h" id="agent-h">Say what you're making. Get a site that <Annotate type="underline">stands out.</Annotate></h2>
      <div class="agent-side">
        <p class="agent-copy">Install once, then ask the way you would ask a designer. The skill picks one recipe, one direction, one palette and one type pairing, then checks its own work for anything generic.</p>
        <ol class="agent-steps mono">
          <li><span>01</span>Install once</li>
          <li><span>02</span>Ask in plain words</li>
          <li><span>03</span><a href="/start">See what it picks</a></li>
        </ol>
      </div>
    </div>
    <div class="agent-grid">
      <AgentTerminal pieces={all.length} pairings={PAIRINGS.length} themes={THEMES.length} />
      <div class="agent-result">
        <div class="agent-stage">
          <span class="sc-live mono" aria-hidden="true"><i></i>The result · live</span>
          {agentHero && <DeviceFrame slug={agentHero.id} platform={agentHero.data.platform} title={agentHero.data.title} interactive />}
        </div>
        {agentHero && (
          <p class="agent-cap mono faint">
            <span>Hero: {agentHero.data.title}</span>
            <a href={`/p/${agentHero.id}`}>Open piece <span aria-hidden="true">→</span></a>
          </p>
        )}
      </div>
    </div>
  </section>

  <Showcase
    id="phones"
    n="02"
    kicker="Phone apps"
    more={{ href: '/platforms/mobile-app', label: 'All phone screens' }}
    slugs={[
      { slug: 'phone-wallet-cards', label: 'Wallet cards' },
      { slug: 'phone-workout-timer', label: 'Workout timer' },
      { slug: 'phone-lesson-quiz', label: 'Lesson quiz' },
      { slug: 'phone-feed-posts', label: 'Social feed' },
      { slug: 'phone-order-tracking', label: 'Order tracking' },
    ]}
  >
    <Fragment slot="title">Phone screens you can actually <Annotate type="circle">tap.</Annotate></Fragment>
    Native-feel app screens at 390 × 844. Lift a card, run the timer, answer the quiz. Each one ships with a brief your agent builds from.
  </Showcase>

  <Showcase
    id="websites"
    n="03"
    kicker="Websites"
    flip
    more={{ href: '/platforms/web', label: 'All web pieces' }}
    slugs={[
      { slug: 'navbar-split-centered-logo', label: 'Split navbar' },
      { slug: 'hero-search-marketplace', label: 'Marketplace search' },
      { slug: 'testimonials-masonry-wall', label: 'Testimonial wall' },
      { slug: 'pricing-usage-slider', label: 'Usage pricing' },
      { slug: 'restaurant-menu-page', label: 'Restaurant menu' },
    ]}
  >
    <Fragment slot="title">Sections with a <Annotate type="highlight">point of view.</Annotate></Fragment>
    Navbars, heroes, pricing, menus. Each one commits to a palette and a type pairing, and every control in the frame works.
  </Showcase>

  <Showcase
    id="motion"
    n="04"
    kicker="Motion"
    more={{ href: '/motion', label: 'All motion' }}
    note="Scroll inside the frame"
    slugs={[
      { slug: 'webgl-shader-hero', label: 'Shader hero' },
      { slug: 'scroll-scrub-product-sequence', label: 'Scroll teardown' },
      { slug: 'parallax-layered-hero', label: 'Layered parallax' },
      { slug: 'page-transition-tile-wipe', label: 'Tile wipe' },
      { slug: 'preloader-counter-intro', label: 'Counter preloader' },
    ]}
  >
    <Fragment slot="title">Motion that <Annotate type="scribble">earns its place.</Annotate></Fragment>
    Shaders, scroll scrubs, parallax, transitions and preloaders. Each moves for a reason and has a reduced-motion fallback.
  </Showcase>

  <Showcase
    id="tablets"
    n="05"
    kicker="Tablet"
    flip
    more={{ href: '/platforms/tablet', label: 'All tablet screens' }}
    slugs={[
      { slug: 'tablet-pos-register', label: 'Cafe register' },
      { slug: 'tablet-cook-mode', label: 'Cook mode' },
      { slug: 'tablet-kiosk-checkin', label: 'Kiosk check-in' },
    ]}
  >
    <Fragment slot="title">Big screens for <Annotate type="underline">busy hands.</Annotate></Fragment>
    Registers, kitchens and front desks. Large targets, type you can read at arm's length, and flows that survive a queue.
  </Showcase>

  <div class="wrap lib-intro">
    <p class="sc-n mono"><span>Nº 06</span><span class="rule" aria-hidden="true"></span><span>The library</span></p>
  </div>

  <section class="section wrap needs">
    <div class="section-head">
      <div>
        <h2 class="display h2">Start</h2>
        <p class="sub">What are you making?</p>
      </div>
      <a class="more" href="/start">All</a>
    </div>
    {SURFACES.map((group) => (
      <div class="need-block">
        <p class="eyebrow"><a href={`/start#${group.id}`}>{group.title}</a></p>
        <ol class="need-grid">
          {startsOn(group.id).map((s) => (
            <li>
              <a href={`/start#${s.id}`}>
                <span class="display h4">{s.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>

  <section class="section wrap seen">
    <div class="section-head">
      <div>
        <h2 class="display h2">Open one</h2>
        <p class="sub">Each card is live. Click to see it and copy its brief.</p>
      </div>
      <a class="more" href="/c">All</a>
    </div>
    <div class="grid">
      {['hero', 'features', 'pricing', 'portfolio', 'dashboard', 'cursor'].map((c, i) => {
        const piece = newest.find((p) => p.data.category === c);
        return piece ? <PieceCard piece={piece} n={nums.get(piece.id) || '000'} index={i} /> : null;
      })}
    </div>
  </section>

  <section class="section wrap libs">
    <div class="section-head">
      <div>
        <h2 class="display h2">System</h2>
        <p class="sub">The fonts, colours, icons, and motion everything uses.</p>
      </div>
      <a class="more" href="/system">All</a>
    </div>
    <ol class="lib-grid">
      {libs.map((l, i) => (
        <li class="reveal" style={`--d:${i * 50}ms`}>
          <a href={l.href}>
            <span class="display h3">{l.title}</span>
            <span class="n mono num">{String(l.n).padStart(2, '0')}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap sources-home">
    <div class="section-head">
      <div>
        <h2 class="display h2">Sources</h2>
        <p class="sub">Real sites the screens learn from.</p>
      </div>
      <a class="more" href="/sources">All</a>
    </div>
    <ol class="source-row">
      {SOURCES.map((s) => (
        <li><a href={`/sources#${s.id}`}><span class="display h4">{s.name}</span></a></li>
      ))}
    </ol>
  </section>

  <section class="section wrap idx">
    <div class="section-head">
      <div>
        <h2 class="display h2">Sections</h2>
        <p class="sub">Every kind of piece, by name.</p>
      </div>
      <a class="more" href="/c">All</a>
    </div>
    <div class="idx-cols">
      {indexGroups.map((g) => (
        <div>
          <p class="eyebrow">{g.label}</p>
          <ol>
            {g.items.map((i) => (
              <li><a href={`/c/${i.c}`}><span>{i.label}</span><span class="mono num faint">{String(i.n).padStart(2, '0')}</span></a></li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap shelves-home">
    <div class="section-head">
      <div>
        <h2 class="display h2">Shelves</h2>
        <p class="sub">Pieces grouped by the problem they solve.</p>
      </div>
      <a class="more" href="/collections">All</a>
    </div>
    <div class="shelf-groups">
      {groupedShelves.map((g) => (
        <div>
          <p class="eyebrow">{g.label}</p>
          <ol>
            {g.items.map((c) => (
              <li>
                <a href={`/collections/${c!.slug}`}>
                  <span class="mono faint">{c!.kicker}</span>
                  <span class="display h4">{c!.title}</span>
                  <span class="mono num faint">{String(c!.pieces.filter((s) => byId.has(s)).length).padStart(2, '0')}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap fresh">
    <div class="section-head">
      <div>
        <h2 class="display h2">Latest</h2>
        <p class="sub">Just added.</p>
      </div>
      <a class="more" href="/browse">All</a>
    </div>
    <div class="grid">
      {fresh.map((p, i) => <PieceCard piece={p} n={nums.get(p.id) || '000'} index={i} />)}
    </div>
  </section>

</Base>

<style>
  .seen { padding-top: clamp(20px, 3vw, 36px); }
  .section { padding-block: clamp(28px, 4vw, 48px); }
  .section-head { margin-bottom: 16px; padding-bottom: 12px; }
  .section-head .h2 { font-size: clamp(28px, 2.4vw, 40px); }
  .section-head .sub { margin-top: 6px; color: var(--ink-2); font-size: 15px; }

  .sc-n { display: flex; align-items: center; gap: 12px; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }
  .sc-n .rule { width: 36px; height: 1px; background: var(--ink-3); }
  .sc-live { position: absolute; left: 14px; top: 6px; z-index: 2; display: inline-flex; align-items: center; gap: 7px; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }
  .sc-live i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: live-pulse 2.4s var(--ease) infinite; }
  @keyframes live-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }

  .agent { padding-block: clamp(48px, 6.5vw, 96px) clamp(36px, 5vw, 64px); border-top: 1px solid var(--line); }
  .agent-head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 20px clamp(32px, 5vw, 80px); align-items: end; margin-bottom: clamp(28px, 4vw, 48px); }
  .agent-head .sc-n { grid-column: 1 / -1; }
  .agent-h { font-size: clamp(36px, 4.2vw, 64px); line-height: 1.03; letter-spacing: -.02em; text-wrap: balance; max-width: 16ch; }
  .agent-side { display: flex; flex-direction: column; gap: 18px; padding-bottom: 6px; }
  .agent-copy { color: var(--ink-2); font-size: 16.5px; line-height: 1.55; max-width: 44ch; text-wrap: pretty; }
  .agent-steps { display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink); }
  .agent-steps span { margin-right: 8px; color: var(--accent); }
  .agent-steps a { border-bottom: 1px solid var(--ink-3); }
  .agent-steps a:hover { color: var(--accent); border-color: var(--accent); }
  .agent-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(16px, 2vw, 28px); align-items: stretch; }
  .agent-result { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .agent-stage { position: relative; flex: 1; min-height: 420px; aspect-ratio: 1280 / 900; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--paper-2) radial-gradient(var(--line-2) 1px, transparent 1.2px) center / 16px 16px; overflow: hidden; }
  .agent-stage :global(lounge-frame) { position: absolute; inset: 26px 22px 20px; }
  .agent-cap { display: flex; justify-content: space-between; gap: 12px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .agent-cap a { color: var(--ink); border-bottom: 1px solid var(--ink-3); }
  .agent-cap a:hover { color: var(--accent); border-color: var(--accent); }
  .lib-intro { padding-top: clamp(40px, 6vw, 72px); border-top: 1px solid var(--line); }
  .lib-intro + .needs { padding-top: 12px; }
  @media (prefers-reduced-motion: reduce) { .sc-live i { animation: none; } }
  .cmd { display: flex; align-items: center; gap: 8px; margin-top: 4px; padding: 6px 6px 6px 12px; border: 1px solid var(--line); border-radius: var(--r); background: var(--paper-2); min-width: 0; }
  .cmd code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; font-family: var(--mono); font-size: 12.5px; }
  .cmd .copy { flex: none; height: 30px; padding: 0 12px; border: 1px solid var(--line-strong, var(--line)); border-radius: var(--r); font-family: var(--mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink); background: var(--paper); }
  .cmd .copy:hover { border-color: var(--ink); }
  .install { display: flex; flex-direction: column; gap: 10px; max-width: 520px; min-width: 0; }
  .cmd.big { padding: 8px 8px 8px 16px; border-color: var(--ink-3); background: var(--paper); }
  .cmd.big code { font-size: 14.5px; color: var(--ink); }
  .cmd.big .prompt { color: var(--accent); font-size: 14px; }
  .cmd.big .copy { height: 38px; padding: 0 16px; background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .cmd.big .copy:hover { opacity: .88; }
  .works { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .works a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px; align-items: center; padding: clamp(40px, 6vw, 80px) 0 clamp(32px, 5vw, 48px); min-height: calc(100vh - var(--header-h) - 200px); }
  .hero-text { display: flex; flex-direction: column; gap: 24px; min-width: 0; }
  .hero .h1 span, .hero .h1 i { display: inline-block; }
  .hero .acts { display: flex; gap: 10px; flex-wrap: wrap; }
  .hero-wall { position: relative; aspect-ratio: 1 / 0.96; }
  .wall-item { position: absolute; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--paper-2); overflow: hidden; transition: transform var(--t-slow) var(--ease-out), border-color var(--t-med), box-shadow var(--t-med); }
  .wall-item :global(lounge-frame) { position: absolute; inset: 12px; }
  .wall-item:hover { border-color: var(--ink-3); box-shadow: var(--shadow); z-index: 5; transform: translateY(-6px); }
  .wall-item.web { left: 0; top: 0; width: 76%; aspect-ratio: 16 / 10.5; }
  .wall-item.phone { right: 0; top: 16%; width: 28%; aspect-ratio: 9 / 19; }
  .wall-item.phone :global(lounge-frame) { inset: 6px; }
  .wall-item.tablet { left: 10%; top: 57%; width: 54%; aspect-ratio: 16 / 11.3; }

  .map { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ink); border-left: 1px solid var(--line); }
  .map a { display: flex; align-items: center; padding: 14px 18px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); min-height: 0; transition: background-color var(--t-med) var(--ease); }
  .map .h4, .need-grid .h4 { font-size: 18px; }
  .map a:hover { background: var(--paper-2); }
  .need-block { margin-top: 22px; }
  .need-block .eyebrow { margin-bottom: 8px; }
  .need-block .eyebrow a { border-bottom: 1px solid transparent; }
  .need-block .eyebrow a:hover { border-color: var(--ink); }
  .need-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ink); border-left: 1px solid var(--line); }
  .need-grid a { display: flex; align-items: center; padding: 12px 16px; min-height: 0; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: background-color var(--t-med) var(--ease); }
  .need-grid a:hover { background: var(--paper-2); }

  .lib-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ink); border-left: 1px solid var(--line); }
  .lib-grid a { display: flex; flex-direction: row; align-items: baseline; justify-content: space-between; gap: 12px; padding: 16px 18px; min-height: 0; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: background-color var(--t-med) var(--ease); }
  .lib-grid a:hover { background: var(--paper-2); }
  .lib-grid .n { font-size: 28px; color: var(--ink-3); }

  .source-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); border-top: 1px solid var(--ink); border-left: 1px solid var(--line); }
  .source-row a { display: flex; align-items: center; padding: 14px 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); min-height: 0; transition: background-color var(--t-med) var(--ease); }
  .source-row a:hover { background: var(--paper-2); }
  .source-row .h4 { font-size: 18px; }
  .idx-cols { display: grid; grid-template-columns: repeat(5, 1fr); gap: 28px 20px; }
  .idx-cols .eyebrow { padding-bottom: 10px; border-bottom: 1px solid var(--ink); margin-bottom: 8px; }
  .idx-cols a { display: flex; justify-content: space-between; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .idx-cols a:hover { color: var(--accent); }

  .shelf-groups { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .shelf-groups .eyebrow { padding-bottom: 10px; border-bottom: 1px solid var(--ink); margin-bottom: 8px; }
  .shelf-groups li a { display: grid; grid-template-columns: 48px 1fr auto; gap: 12px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .shelf-groups li a:hover .h4 { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 1100px) {
    .idx-cols { grid-template-columns: repeat(3, 1fr); }
    .need-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 960px) {
    .agent-head, .agent-grid { grid-template-columns: minmax(0, 1fr); }
    .agent-stage { min-height: 0; }
    .agent-cap { flex-direction: column; gap: 6px; }
    .hero { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .map, .lib-grid { grid-template-columns: repeat(2, 1fr); }
