---
import Base from '../layouts/Base.astro';
import DeviceFrame from '../components/DeviceFrame.astro';
import { getPieces, CATEGORY_META, about } from '../lib/pieces';
import { PAIRINGS } from '../data/type';
import { THEMES } from '../data/themes';
import { ICONS } from '../data/icons';
import { RECIPES } from '../data/motion';
import { STARTS } from '../data/starts';
import { AUTHOR } from '../lib/pieces';
import { EXAMPLES, PAIRS, SOLO, exampleUrl } from '../data/examples';
import { CALLS, tokensOf, typicalTokens, benchSummary, SHOWCASE, SUBJECTS, REVIEWS, BENCH_META } from '../data/benchmark';
import { ROWS, LOUNGE, RIVALS, CHECKED } from '../data/compare';
import mcp from '../../mcp/package.json';

const all = await getPieces();
const newest = [...all].reverse();
const byId = new Map(all.map((p) => [p.id, p]));
const featured = all.filter((p) => p.data.featured);
const pick = (platform: string) => featured.find((p) => p.data.platform === platform) ?? newest.find((p) => p.data.platform === platform);
const heroWeb = pick('web') ?? newest[0];
const heroPhone = pick('mobile-app') ?? pick('pwa') ?? pick('mobile-web');
const heroTablet = pick('tablet');


const typeCount = (t: string) => all.filter((p) => p.data.type === t).length;
const catCount = (c: string) => all.filter((p) => p.data.category === c).length;
const previewSection = byId.get('hero-search-marketplace') ?? newest.find((p) => p.data.type === 'section');
const previewScreen = byId.get('phone-wallet-cards') ?? newest.find((p) => p.data.platform === 'mobile-app');
const previewMotion = byId.get('webgl-shader-hero') ?? newest.find((p) => p.data.type === 'animation');
const componentCats = (['navigation', 'buttons', 'inputs', 'cards', 'overlays', 'charts', 'pickers', 'feedback'] as const).filter((c) => catCount(c) > 0);
const dialectNames = all
  .filter((p) => p.data.type === 'style')
  .map((p) => p.data.title.replace(/ design language kit$/i, '').replace(/ design style$/i, '').replace(/ style sheet$/i, '').replace(/ style$/i, '').replace(/ kit$/i, ''))
  .sort((a, b) => a.localeCompare(b));
const system = [
  { n: PAIRINGS.length, label: 'Type pairings', href: '/type' },
  { n: THEMES.length, label: 'Themes', href: '/themes' },
  { n: ICONS.length, label: 'Icons', href: '/icons' },
  { n: RECIPES.length, label: 'Motion recipes', href: '/motion' },
];
// The sites the homepage shows under Built from one prompt: one of each kind of look.
const homeBuilt = ['meridian-no-7', 'late-light', 'key-01', 'thulo-dhunga', 'aadhi-raat', 'halden-chambers'].map((id) => SOLO.find((e) => e.id === id)).filter((e) => e !== undefined);
const installCmd = 'npx skills add SusanAcharya/Design-Lounge';
const mcpCmd = 'claude mcp add -s user design-lounge -- npx -y design-lounge-mcp@latest';
const cost = (tool: string) => tokensOf(CALLS.find((c) => c.tool === tool)!.chars);
const k = (n: number) => `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k`;
const bench = benchSummary();
const show = SUBJECTS.find((s) => s.id === SHOWCASE.subject)!;
const showModel = BENCH_META.model.replace(/\s*\(.*\)$/, '');
const showSides = (['without', 'with'] as const).map((arm) => ({
  arm,
  label: arm === 'with' ? 'With Design Lounge' : `${showModel} alone`,
  fails: REVIEWS.find((r) => r.subject === show.id && r.arm === arm)!.fails,
  notes: SHOWCASE[arm],
  href: `/built/bench/${show.id}-${arm}/index.html`,
  alt: `${show.title} landing page, first screen, built ${arm === 'with' ? 'with Design Lounge' : `by ${showModel} alone`}`,
}));
// The hero wall: real pieces, four columns, chosen for range (type-led, illustrated, product, dark, editorial).
const wallCols = [
  ['hero-bauhaus-composition', 'landing-fashion-atelier', 'hero-engraved-moonrise-plate', 'app-icon-colour-wall', 'portfolio-architect-index', 'cta-giant-email-band'],
  ['hero-3d-product-turn', 'collage-hero', 'hero-kinetic-scroll-type', 'restaurant-menu-page', 'sunset-grid-hero', 'editorial-landing-hero'],
  ['moonlit-ridge-hero', 'hero-swiss-grid-wordmark', 'cartoon-sticker-landing', 'product-configurator-material', 'case-file-horizontal-scroll', 'hero-search-marketplace'],
  ['hero-editorial-name-rotator', 'playable-product-hero', 'gym-membership-home', 'taped-photo-grid', 'hero-machined-part-breakout', 'brutalist-studio-home'],
].map((col) => col.filter((id) => byId.has(id)));
const markText = { yes: 'Yes', no: 'No', part: 'In part' } as const;
const faq = [
  { q: 'What is Design Lounge?', a: `Design Lounge is a free UI design skill for AI coding agents, plus a library of ${about(all.length)} design ideas: website sections, app screens, components and motion. Each one has a live demo and a written brief that an agent can build from.` },
  { q: 'How do I add the UI design skill to my agent?', a: `Add the MCP server, which installs the skill too and adds tools that show your agent each piece and check the page it built. In Claude Code, run ${mcpCmd}. Cursor, Codex, VS Code and Claude Desktop take npx -y design-lounge-mcp@latest in their MCP settings, and Claude.ai or ChatGPT can add https://www.designlounge.live/api/mcp as a connector for the library tools. For the skill alone, run ${installCmd} in your project (it needs Node 22.20 or newer). Then ask for what you are making, such as a portfolio, a shop or a dashboard.` },
  { q: 'What does the skill do differently?', a: `It makes your agent design from a real library instead of its own defaults. For a product, it picks a theme, a font pairing, a radius and motion from the library, builds the screens from piece briefs, then opens the page and checks it for the usual signs of AI-made design. When you ask for spectacle, it builds one centrepiece made for your subject, with real light and depth, and holds the rest of the page to the same craft.` },
  { q: 'Is it free to use in my products?', a: 'Yes. The pieces, themes, type pairings and icons are free to use in your own products and client work. A small credit line is appreciated. Please do not republish the library itself as a library.' },
  { q: 'Where do the design ideas come from?', a: `Every piece is an original design with an invented brand. Some study the craft of public sites, such as Stripe or Linear, and those are listed on the Sources page. No piece copies another site's text, images or logo.` },
  { q: 'How many tokens does the Design Lounge MCP use?', a: `About ${k(typicalTokens())} tokens for a whole direction: the plan from start_design (about ${k(cost('start_design'))}), a recipe, a theme and a pairing (about ${k(cost('get_recipe') + cost('get_theme') + cost('get_pairing'))} together), three piece briefs (about ${k(cost('get_piece'))} each) and one review. The tool list itself is about ${k(cost('tools/list'))}. The Benchmark page has the builds it was measured on.` },
  { q: 'Should I use the MCP server or the skill?', a: 'The MCP server, if your agent supports MCP. It installs the skill too, and adds tools that show your agent a picture of each piece, search the library, and review the page it built. The skill alone is a folder of files your agent reads, for agents without MCP.' },
  { q: 'Which agents does it work with?', a: 'Claude Code, Cursor, Codex, VS Code, Windsurf and Claude Desktop through the npm package design-lounge-mcp. Claude.ai, ChatGPT and other clients that take a remote connector can use https://www.designlounge.live/api/mcp, which has the library tools; page reviews run in the npm package. Agents without MCP can install the skill with npx skills add SusanAcharya/Design-Lounge.' },
  { q: 'Does it work with React, Flutter or SwiftUI?', a: 'Yes. Every demo is plain HTML, CSS and vanilla JavaScript, with no framework, packages or versions that could clash with your project. A brief describes the design in numbers, not in one framework, so your agent rebuilds it in your stack: React, Vue, Svelte, Astro, React Native, Flutter, SwiftUI or Compose. It sits well on top of a component library such as shadcn/ui.' },
  { q: 'How is it different from shadcn/ui, Arc UI, Mobbin or 21st.dev?', a: 'Those give your agent components to install or screenshots to look at. Design Lounge gives it a direction: a palette, a type pairing and a page recipe that agree, live pieces with numeric briefs, and a review of the finished page for design, SEO, AEO and GEO. It works alongside them. The comparison on this page shows what each one covers.' },
  { q: 'What does the review check?', a: 'It checks a built page for design, SEO, AEO and GEO in one pass, and lists the fails first. On design, review_page fails the usual signs of AI-made pages: gradient text, an icon over a title over a sentence three times, numbered eyebrows, glass everywhere, invented fonts. It checks that the page keeps its locked kit. On search, it scores titles, descriptions, headings, structured data, and answers that a search or AI engine can quote. The local server also screenshots the page and runs accessibility checks.' },
  { q: 'Does the MCP server see my code?', a: 'No. The npm package runs on your machine and bundles the library and thumbnails, so nothing is sent to Design Lounge and there is no tracking. review_page reads only the file or URL your agent gives it. The hosted connector receives only the words your agent sends it, such as a request or a piece name, and does not store them.' },
  { q: 'Who made Design Lounge?', a: `${AUTHOR.name}, a ${AUTHOR.role.toLowerCase()} based in ${AUTHOR.city}, Nepal.` },
];
---
<Base rail={false} fullTitle="Design Lounge: a UI design skill and design ideas for AI agents" description={`A free UI design skill for Cursor, Claude Code and Codex, with ${about(all.length)} live design ideas: sections, app screens, palettes, font pairings and motion.`} faq={faq}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="wall" role="img" aria-label={`A wall of ${about(all.length)} designs from the library: product pages, editorial sites, games, menus and dashboards`}>
      <div class="wall-plane">
        {wallCols.map((col, c) => (
          <div class={`wall-col c${c}`}>
            {[...col, ...col].map((id, i) => (
              <img src={`/thumbs/${id}.webp`} alt="" width="640" height="400" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="wrap hero-in">
      <div class="hero-text">
        <h1 class="display hero-h reveal" id="hero-h">Give your AI agent <i>design taste.</i></h1>
        <p class="hero-lede reveal" style="--d:80ms">{about(all.length)} live designs your agent builds from, so what it ships looks made on purpose.</p>
        <div class="install reveal" style="--d:160ms">
          <span class="cmd">
            <span class="prompt mono" aria-hidden="true">$</span>
            <code id="hero-cmd">{mcpCmd}</code>
            <button class="copy" type="button" data-copy="#hero-cmd"><span data-label>Copy</span></button>
          </span>
          <p class="cmd-note">For Claude Code, and it installs the skill too. <a href="/agents">Cursor, Codex and ChatGPT</a>, or <a href="/agents#skill">the skill alone</a>.</p>
        </div>
        <a class="textlink reveal" style="--d:220ms" href="/browse">Browse the library <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="ba wrap" id="see" aria-labelledby="ba-h">
    <div class="ba-grid">
      <div class="ba-copy">
        <h2 class="display h2" id="ba-h">One prompt, two builds.</h2>
        <p class="ba-lede">The same request to the same model. With Design Lounge, the agent locked one palette, one font pairing and one page plan, built each part from a live piece, then checked its own page. Drag the line to compare.</p>
        <blockquote class="ba-quote">“{show.prompt}”</blockquote>
        <div class="ba-sides">
          {showSides.map((s) => (
            <div class={`ba-side ${s.arm}`}>
              <p class="ba-side-h"><span>{s.label}</span><span class="num">{s.fails} review {s.fails === 1 ? 'fail' : 'fails'}</span></p>
              <ul>{s.notes.slice(0, 2).map((n) => <li>{n}</li>)}</ul>
              <a class="ba-open" href={s.href} target="_blank" rel="noopener">Open this build <span aria-hidden="true">↗</span></a>
            </div>
          ))}
        </div>
      </div>
      <div class="ba-frame">
        <div class="ba-stage" data-ba style="--pos: 50%">
          <img class="ba-img" src={`/built/bench/${show.id}-without/cover.jpg`} alt={showSides[0].alt} width="1280" height="800" loading="lazy" decoding="async" />
          <div class="ba-with">
            <img class="ba-img" src={`/built/bench/${show.id}-with/cover.jpg`} alt={showSides[1].alt} width="1280" height="800" loading="lazy" decoding="async" />
          </div>
          <span class="ba-tag left">{showSides[0].label}</span>
          <span class="ba-tag right">With Design Lounge</span>
          <span class="ba-handle" aria-hidden="true"><span>‹ ›</span></span>
          <input class="ba-range" type="range" min="0" max="100" value="50" step="1" aria-label="Drag to compare the build without Design Lounge (left) and with it (right)" />
        </div>
      </div>
    </div>
    <dl class="figs">
      <div><dt class="fig num">{bench.failsWith} vs {bench.failsWithout}</dt><dd>Review fails across all {bench.builds} builds, with the Lounge and without it</dd></div>
      <div><dt class="fig num">{bench.contrastWith} vs {bench.contrastWithout}</dt><dd>Lines of text too faint to read</dd></div>
      <div><dt class="fig num">{bench.a11yWith}</dt><dd>Accessibility score on every Lounge build, against {bench.a11yWithout} without</dd></div>
      <div><dt class="fig num">{bench.judgeHigher} of {bench.judged}</dt><dd>Pairs where a blind design rating scored the Lounge build higher</dd></div>
    </dl>
    <p class="figs-more"><a class="textlink" href="/benchmark">How these were measured <span aria-hidden="true">→</span></a></p>
  </section>

  <section class="built wrap" aria-labelledby="built-h">
    <header class="built-head">
      <div>
        <h2 class="display h2" id="built-h">Six sites, one prompt each.</h2>
        <p class="lede">Each one built by a coding agent with Design Lounge, in one go. Open any of them and use it.</p>
      </div>
      <span class="textlinks">
        <a class="textlink" href="/examples">All {EXAMPLES.length} sites <span aria-hidden="true">→</span></a>
        <a class="textlink" href="/examples/compare">Same prompt, different style <span aria-hidden="true">→</span></a>
      </span>
    </header>
    <ol class="built-grid">
      {homeBuilt.map((e) => (
        <li>
          <a href={exampleUrl(e)} class="built-card">
            <span class="built-shot"><img src={`/built/${e.id}/cover.jpg`} alt={`${e.title}, built by an agent with Design Lounge`} width="1280" height="800" loading="lazy" decoding="async" /></span>
            <span class="built-cap"><b>{e.title}</b><span>“{e.prompt}”</span></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="lib wrap" aria-labelledby="lib-h">
    <header class="block-head">
      <h2 class="display h2" id="lib-h">{about(all.length)} designs your agent can build from.</h2>
      <p class="lede">Every piece runs live and comes with a written brief: sizes, colours, timing and states. Free to use in your own products.</p>
    </header>
    <div class="bento">
      <a class="cell c-sections" href="/browse?type=section">
        <div class="cell-text">
          <h3 class="cell-h">Sections <span class="cell-n num">{typeCount('section')}</span></h3>
          <p>Heroes, pricing, footers, menus. The blocks a website is built from.</p>
        </div>
        {previewSection && <div class="cell-stage web"><DeviceFrame slug={previewSection.id} platform={previewSection.data.platform} title={previewSection.data.title} /></div>}
      </a>
      <a class="cell c-screens" href="/browse?type=screen">
        <div class="cell-text">
          <h3 class="cell-h">Screens <span class="cell-n num">{typeCount('screen')}</span></h3>
          <p>Whole pages and app screens, end to end.</p>
        </div>
        {previewScreen && <div class="cell-stage phone"><DeviceFrame slug={previewScreen.id} platform={previewScreen.data.platform} title={previewScreen.data.title} /></div>}
      </a>
      <a class="cell c-motion" href="/browse?type=animation">
        <div class="cell-text">
          <h3 class="cell-h">Animations <span class="cell-n num">{typeCount('animation')}</span></h3>
        </div>
        {previewMotion && <div class="cell-stage web small"><DeviceFrame slug={previewMotion.id} platform={previewMotion.data.platform} title={previewMotion.data.title} /></div>}
      </a>
      <a class="cell c-components" href="/browse?type=component">
        <div class="cell-text">
          <h3 class="cell-h">Components <span class="cell-n num">{typeCount('component')}</span></h3>
        </div>
        <ul class="tags">
          {componentCats.map((c) => <li>{CATEGORY_META[c].label}</li>)}
        </ul>
      </a>
      <a class="cell c-styles" href="/browse?type=style">
        <div class="cell-text">
          <h3 class="cell-h">Design languages <span class="cell-n num">{typeCount('style')}</span></h3>
          <p>Whole visual dialects shown as a kit.</p>
        </div>
        <ul class="style-words" aria-label="Design languages">
          {dialectNames.map((s) => <li>{s}</li>)}
        </ul>
      </a>
      <div class="cell c-more">
        <a href="/browse?type=layout"><span class="cell-h">Layouts <span class="cell-n num">{typeCount('layout')}</span></span></a>
        <a href="/browse?type=pattern"><span class="cell-h">Patterns <span class="cell-n num">{typeCount('pattern')}</span></span></a>
      </div>
      <div class="cell c-system">
        <h3 class="cell-h"><a href="/system">The system underneath <span aria-hidden="true">→</span></a></h3>
        <ul class="sys">
          {system.map((s) => (
            <li><a href={s.href}><span class="cell-n num">{s.n}</span><span>{s.label}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="cmp wrap" aria-labelledby="cmp-h">
    <header class="block-head">
      <h2 class="display h2" id="cmp-h">A direction and a review, in one free MCP.</h2>
      <p class="lede">Other tools hand your agent components to install or screenshots to look at. Design Lounge gives it a palette, a pairing and pieces that agree, then reviews what it built. It works on top of the components you already use: shadcn/ui, Arc UI, or your own.</p>
    </header>
    <div class="cmp-scroll" role="region" aria-labelledby="cmp-h" tabindex="0">
      <table class="cmp-table">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Feature</span></th>
            <th scope="col" class="us">Design Lounge</th>
            {RIVALS.map((r) => <th scope="col"><a href={r.href} rel="noopener">{r.name}</a></th>)}
          </tr>
        </thead>
        <tbody>
          {ROWS.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td class="us"><span class={`mk ${LOUNGE.marks[row.key]}`}>{markText[LOUNGE.marks[row.key]]}</span></td>
              {RIVALS.map((r) => <td><span class={`mk ${r.marks[row.key]}`}>{markText[r.marks[row.key]]}</span></td>)}
            </tr>
          ))}
          <tr class="price">
            <th scope="row">Price</th>
            <td class="us">{LOUNGE.price}</td>
            {RIVALS.map((r) => <td>{r.price}</td>)}
          </tr>
        </tbody>
      </table>
    </div>
    <p class="cmp-note">Checked {CHECKED} on each product's own pages. Something out of date? <a href="https://github.com/SusanAcharya/Design-Lounge/issues" rel="noopener">Open an issue</a>.</p>
  </section>

  <section class="faq wrap" aria-labelledby="faq-h">
    <div class="faq-head">
      <h2 class="display h2" id="faq-h">Questions</h2>
      <p class="lede">The short version of how the skill and the library work.</p>
    </div>
    <div class="faq-list">
      {faq.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

</Base>

<script>
  // Before and after: the range input drives the split. The first time the stage comes into view it sweeps once
  // to show that it moves, unless the visitor prefers less motion or has already touched it.
  for (const stage of document.querySelectorAll<HTMLElement>('[data-ba]')) {
    const range = stage.querySelector<HTMLInputElement>('.ba-range')!;
    const set = (v: number) => { stage.style.setProperty('--pos', `${v}%`); range.value = String(v); };
    let touched = false;
    range.addEventListener('input', () => { touched = true; set(Number(range.value)); });
    range.addEventListener('pointerdown', () => { touched = true; stage.dataset.active = ''; });
    window.addEventListener('pointerup', () => { delete stage.dataset.active; });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const keys = [[0, 50], [700, 30], [1500, 68], [2200, 50]];
        const t0 = performance.now();
        const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
        const tick = (now: number) => {
          if (touched) return;
          const t = now - t0;
          const i = keys.findIndex(([at]) => at > t);
          if (i === -1) { set(50); return; }
          const [a0, v0] = keys[i - 1], [a1, v1] = keys[i];
          set(v0 + (v1 - v0) * ease((t - a0) / (a1 - a0)));
          requestAnimationFrame(tick);
        };
        setTimeout(() => requestAnimationFrame(tick), 600);
      }, { threshold: 0.5 });
      io.observe(stage);
    }
  }
</script>

<style>
  /* hero: the claim and the install on the left, a slow wall of real pieces on the right */
  .hero { position: relative; overflow: hidden; min-height: min(calc(100dvh - var(--header-h)), 860px); display: flex; align-items: center; border-bottom: 1px solid var(--line); }
  .hero-in { position: relative; z-index: 1; padding-block: clamp(48px, 7vw, 96px); }
  .hero-text { display: flex; flex-direction: column; align-items: flex-start; gap: 28px; max-width: 660px; }
  .hero-text .install { max-width: 560px; }
  .hero-h { font-size: clamp(44px, 5.3vw, 76px); line-height: 0.98; letter-spacing: -0.045em; }
  .hero-lede { max-width: 40ch; font-size: clamp(17px, 1.35vw, 19px); line-height: 1.55; color: var(--ink-2); text-wrap: pretty; }
  .hero-links { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 26px; }

  .wall { position: absolute; top: 0; bottom: 0; left: 46%; right: 0; pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22%), linear-gradient(180deg, transparent 0, #000 14%, #000 86%, transparent 100%);
    -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, transparent 0, #000 22%), linear-gradient(180deg, transparent 0, #000 14%, #000 86%, transparent 100%); mask-composite: intersect; }
  .wall-plane { position: absolute; top: -30%; bottom: -30%; left: 4%; width: 118%; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px;
    transform: perspective(2200px) rotateX(22deg) rotateY(-18deg) rotateZ(9deg); transform-origin: 30% 50%; }
  .wall-col { display: flex; flex-direction: column; gap: 16px; animation: wall-up 90s linear infinite; will-change: transform; }
  .wall-col.c1 { animation-name: wall-down; animation-duration: 110s; }
  .wall-col.c2 { animation-duration: 100s; }
  .wall-col.c3 { animation-name: wall-down; animation-duration: 120s; }
  .wall-col img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: var(--r-md); border: 1px solid var(--line); background: var(--paper-2); box-shadow: 0 1px 0 rgba(24, 24, 27, .04), 0 18px 36px -24px rgba(24, 24, 27, .35); }
  @keyframes wall-up { from { transform: translateY(0); } to { transform: translateY(calc(-50% - 8px)); } }
  @keyframes wall-down { from { transform: translateY(calc(-50% - 8px)); } to { transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .wall-col { animation: none; } }

