---
import Base from '../layouts/Base.astro';
import DeviceFrame from '../components/DeviceFrame.astro';
import Showcase from '../components/Showcase.astro';
import AgentTerminal from '../components/AgentTerminal.astro';
import { getPieces, CATEGORY_META, STYLE_META } from '../lib/pieces';
import { PAIRINGS } from '../data/type';
import { THEMES } from '../data/themes';
import { ICONS } from '../data/icons';
import { RECIPES } from '../data/motion';
import { STARTS } from '../data/starts';
import { AUTHOR } from '../lib/pieces';
import { EXAMPLES, exampleUrl } from '../data/examples';

const all = await getPieces();
const newest = [...all].reverse();
const byId = new Map(all.map((p) => [p.id, p]));
const featured = all.filter((p) => p.data.featured);
const pick = (platform: string) => featured.find((p) => p.data.platform === platform) ?? newest.find((p) => p.data.platform === platform);
const heroWeb = pick('web') ?? newest[0];
const heroPhone = pick('mobile-app') ?? pick('pwa') ?? pick('mobile-web');
const heroTablet = pick('tablet');

const saas = STARTS.find((s) => s.id === 'saas');
const lime = saas?.directions.find((d) => d.id === 'lime-engine');
const agentHero = byId.get(lime?.hero ?? 'hero-split-ui-stack') ?? byId.get('hero-split-ui-stack');

const typeCount = (t: string) => all.filter((p) => p.data.type === t).length;
const catCount = (c: string) => all.filter((p) => p.data.category === c).length;
const previewSection = byId.get('hero-search-marketplace') ?? newest.find((p) => p.data.type === 'section');
const previewScreen = byId.get('phone-wallet-cards') ?? newest.find((p) => p.data.platform === 'mobile-app');
const previewMotion = byId.get('webgl-shader-hero') ?? newest.find((p) => p.data.type === 'animation');
const componentCats = (['navigation', 'buttons', 'inputs', 'cards', 'overlays', 'charts', 'pickers', 'feedback'] as const).filter((c) => catCount(c) > 0);
const styleNames = Object.values(STYLE_META).slice(0, 10).map((s) => s.label);
const system = [
  { n: PAIRINGS.length, label: 'Type pairings', href: '/type' },
  { n: THEMES.length, label: 'Themes', href: '/themes' },
  { n: ICONS.length, label: 'Icons', href: '/icons' },
  { n: RECIPES.length, label: 'Motion recipes', href: '/motion' },
];
const installCmd = 'npx skills add SusanAcharya/Design-Lounge';
const faq = [
  { q: 'What is Design Lounge?', a: `Design Lounge is a free UI design skill for AI coding agents, plus a library of ${all.length} design ideas: website sections, app screens, components and motion. Each one has a live demo and a written brief that an agent can build from.` },
  { q: 'How do I add the UI design skill to my agent?', a: `Run ${installCmd} in your project. It works with Cursor, Claude Code, Codex and other agents that read skills. Then ask for what you are making, such as a portfolio, a shop or a dashboard.` },
  { q: 'What does the skill do differently?', a: `It stops the agent from inventing a look. The agent picks a real theme, a font pairing, a radius and motion from the library, builds the screens from piece briefs, then opens the page and checks it for the usual signs of AI-made design.` },
  { q: 'Is it free to use in my products?', a: 'Yes. The pieces, themes, type pairings and icons are free to use in your own products and client work. A small credit line is appreciated. Please do not republish the library itself as a library.' },
  { q: 'Where do the design ideas come from?', a: `Every piece is an original design with an invented brand. Some study the craft of public sites, such as Stripe or Linear, and those are listed on the Sources page. No piece copies another site's text, images or logo.` },
  { q: 'Who made Design Lounge?', a: `${AUTHOR.name}, a ${AUTHOR.role.toLowerCase()} based in ${AUTHOR.city}, Nepal.` },
];
---
<Base rail={false} fullTitle="Design Lounge: a UI design skill and design ideas for AI agents" description={`Design Lounge is a free UI design skill for AI coding agents, with ${all.length} design ideas you can see live: website sections, app screens, palettes, font pairings, icons and motion.`} faq={faq}>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow reveal">Design Lounge</p>
      <h1 class="display h1 reveal">Give your AI agent <i>design taste.</i></h1>
      <p class="lede reveal" style="--d:80ms">A free UI design skill and a library of {all.length} live design ideas. Your agent picks real type, colour and motion, then builds.</p>
      <div class="hero-cta reveal" style="--d:160ms">
        <span class="cmd big">
          <span class="prompt mono" aria-hidden="true">$</span>
          <code id="hero-cmd">{installCmd}</code>
          <button class="copy" type="button" data-copy="#hero-cmd"><span data-label>Copy</span></button>
        </span>
        <a class="textlink" href="/browse">Browse the library <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-wall reveal" style="--d:120ms" aria-label="Featured pieces">
      {heroWeb && (
        <a class="wall-item web" href={`/p/${heroWeb.id}`} aria-label={heroWeb.data.title}>
          <DeviceFrame slug={heroWeb.id} platform={heroWeb.data.platform} title={heroWeb.data.title} eager />
        </a>
      )}
      {heroPhone && (
        <a class="wall-item phone" href={`/p/${heroPhone.id}`} aria-label={heroPhone.data.title}>
          <DeviceFrame slug={heroPhone.id} platform={heroPhone.data.platform} title={heroPhone.data.title} eager />
        </a>
      )}
      {heroTablet && (
        <a class="wall-item tablet" href={`/p/${heroTablet.id}`} aria-label={heroTablet.data.title}>
          <DeviceFrame slug={heroTablet.id} platform={heroTablet.data.platform} title={heroTablet.data.title} />
        </a>
      )}
    </div>
  </section>

  <section class="lib wrap" aria-labelledby="lib-h">
    <header class="block-head">
      <h2 class="display h2" id="lib-h">A library your agent can actually use.</h2>
      <p class="lede">Every piece runs live, comes with a written brief, and is free to use in your products.</p>
    </header>
    <div class="bento">
      <a class="cell c-sections" href="/browse?type=section">
        <div class="cell-text">
          <span class="cell-n num">{typeCount('section')}</span>
          <h3 class="cell-h">Sections</h3>
          <p>Heroes, pricing, footers, menus. The blocks a website is built from.</p>
        </div>
        {previewSection && <div class="cell-stage web"><DeviceFrame slug={previewSection.id} platform={previewSection.data.platform} title={previewSection.data.title} /></div>}
      </a>
      <a class="cell c-screens" href="/browse?type=screen">
        <div class="cell-text">
          <span class="cell-n num">{typeCount('screen')}</span>
          <h3 class="cell-h">Screens</h3>
          <p>Whole pages and app screens, end to end.</p>
        </div>
        {previewScreen && <div class="cell-stage phone"><DeviceFrame slug={previewScreen.id} platform={previewScreen.data.platform} title={previewScreen.data.title} /></div>}
      </a>
      <a class="cell c-motion" href="/browse?type=animation">
        <div class="cell-text">
          <span class="cell-n num">{typeCount('animation')}</span>
          <h3 class="cell-h">Animations</h3>
        </div>
        {previewMotion && <div class="cell-stage web small"><DeviceFrame slug={previewMotion.id} platform={previewMotion.data.platform} title={previewMotion.data.title} /></div>}
      </a>
      <a class="cell c-components" href="/browse?type=component">
        <div class="cell-text">
          <span class="cell-n num">{typeCount('component')}</span>
          <h3 class="cell-h">Components</h3>
        </div>
        <ul class="tags">
          {componentCats.map((c) => <li>{CATEGORY_META[c].label}</li>)}
        </ul>
      </a>
      <a class="cell c-styles" href="/browse?type=style">
        <div class="cell-text">
          <span class="cell-n num">{typeCount('style')}</span>
          <h3 class="cell-h">Design languages</h3>
          <p>Whole visual dialects shown as a kit.</p>
        </div>
        <ul class="style-words" aria-label="Some of the styles">
          {styleNames.map((s) => <li>{s}</li>)}
        </ul>
      </a>
      <div class="cell c-more">
        <a href="/browse?type=layout"><span class="cell-n num">{typeCount('layout')}</span><span class="cell-h">Layouts</span></a>
        <a href="/browse?type=pattern"><span class="cell-n num">{typeCount('pattern')}</span><span class="cell-h">Patterns</span></a>
      </div>
      <div class="cell c-system">
        <h3 class="cell-h"><a href="/system">The system underneath <span aria-hidden="true">→</span></a></h3>
        <ul class="sys">
          {system.map((s) => (
            <li><a href={s.href}><span class="cell-n num">{s.n}</span><span>{s.label}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="skill wrap" id="agent" aria-labelledby="agent-h">
    <header class="block-head">
      <p class="eyebrow">The skill</p>
      <h2 class="display h2" id="agent-h">Say what you're making. It picks the rest.</h2>
      <p class="lede">Your agent reads the skill, chooses one recipe, one palette and one type pairing from the library, then checks its own work for anything generic.</p>
    </header>
    <ol class="steps">
      <li><b>Install</b><span>One command in Cursor, Claude Code or Codex.</span></li>
      <li><b>Ask</b><span>"Build me a SaaS landing page." Plain words are enough.</span></li>
      <li><b>Ship</b><span>Real code with a palette, a pairing and pieces that fit.</span></li>
    </ol>
    <div class="agent-grid">
      <AgentTerminal pieces={all.length} pairings={PAIRINGS.length} themes={THEMES.length} />
      <div class="agent-result">
        <div class="agent-stage">
          {agentHero && <DeviceFrame slug={agentHero.id} platform={agentHero.data.platform} title={agentHero.data.title} interactive />}
        </div>
        {agentHero && (
          <p class="agent-cap">
            <span>The result: {agentHero.data.title}</span>
            <a href={`/p/${agentHero.id}`}>Open piece <span aria-hidden="true">→</span></a>
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="built wrap" aria-labelledby="built-h">
    <header class="built-head">
      <div>
        <p class="eyebrow">Examples</p>
        <h2 class="display h2" id="built-h">Built from one prompt.</h2>
      </div>
      <a class="textlink" href="/examples">All {EXAMPLES.length} sites <span aria-hidden="true">→</span></a>
    </header>
    <ol class="built-row">
      {EXAMPLES.filter((e) => !e.phone).slice(0, 3).map((e) => (
        <li>
          <a href={exampleUrl(e)} class="built-card">
            <img src={`/built/${e.id}/cover.jpg`} alt={`${e.title}, built by an agent with the skill`} width="1280" height="800" loading="lazy" />
            <span class="built-cap"><b>{e.title}</b><span>{e.prompt}</span></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="feats wrap" aria-labelledby="feats-h">
    <header class="feats-head">
      <h2 class="display h2" id="feats-h">More than a gallery.</h2>
      <p class="lede">Every piece is something you can take. Around them sit the tools that tie a product together.</p>
      <a class="btn" href="/agents">How it works</a>
    </header>
    <div class="feats-body">
      <div class="fgroup">
        <h3 class="fgroup-h">In every piece</h3>
        <ul>
          <li><b>Live demo</b><span>Every control works, inside a real browser, phone or tablet frame.</span></li>
          <li><b>Brief</b><span>A written spec your agent builds from. One click to copy.</span></li>
          <li><b>Source</b><span>The HTML, credited and free to use in your own products.</span></li>
        </ul>
      </div>
      <div class="fgroup">
        <h3 class="fgroup-h">Around the pieces</h3>
        <ul>
          <li><a href="/start"><b>Start</b><span>Pick what you're making. Get a theme, a pairing and the pieces that fit.</span></a></li>
          <li><a href="/kit"><b>Kit</b><span>Compose a kind, a palette, a pairing and an icon family into one brief.</span></a></li>
          <li><a href="/system"><b>System</b><span>{PAIRINGS.length} type pairings, {THEMES.length} themes, icons and motion recipes.</span></a></li>
          <li><button type="button" data-open-palette><b>Search</b><span>Press <kbd>⌘K</kbd> anywhere to jump to any piece.</span></button></li>
          <li><a href="/llms.txt"><b>For agents</b><span>An llms.txt and a JSON catalogue, so tools can read the library directly.</span></a></li>
        </ul>
      </div>
    </div>
  </section>

  <Showcase
    id="phones"
    kicker="Phone apps"
    more={{ href: '/browse?platform=mobile-app', label: 'All phone screens' }}
    slugs={[
      { slug: 'phone-wallet-cards', label: 'Wallet cards' },
      { slug: 'phone-workout-timer', label: 'Workout timer' },
      { slug: 'phone-lesson-quiz', label: 'Lesson quiz' },
      { slug: 'phone-feed-posts', label: 'Social feed' },
      { slug: 'phone-order-tracking', label: 'Order tracking' },
    ]}
  >
    <Fragment slot="title">Tap through a few right here.</Fragment>
    Real app screens at 390 × 844. Lift a card, run the timer, answer the quiz. Each ships with the brief your agent builds from.
  </Showcase>

  <section class="faq wrap" aria-labelledby="faq-h">
    <div class="faq-head">
      <h2 class="display h2" id="faq-h">Questions</h2>
      <p class="lede">The short version of how the skill and the library work.</p>
    </div>
    <div class="faq-list">
      {faq.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="bio wrap" aria-labelledby="bio-h">
    <p class="eyebrow">Made by</p>
    <h2 class="display h3" id="bio-h"><a href="/about">{AUTHOR.name}</a></h2>
    <p class="bio-text">{AUTHOR.role} in {AUTHOR.city}, Nepal. She builds products end to end and made Design Lounge so AI agents stop shipping the same generic page. Every piece, theme and brief here is hers.</p>
    <p class="bio-links">
      <a href="/about">About the Lounge</a>
      {AUTHOR.links.map((l) => <a href={l.href} target="_blank" rel="noopener me">{l.label} ↗</a>)}
    </p>
  </section>

  <section class="close wrap" aria-labelledby="close-h">
    <h2 class="display h2" id="close-h">Install once. Ask for anything.</h2>
    <span class="cmd big">
      <span class="prompt mono" aria-hidden="true">$</span>
      <code id="close-cmd">{installCmd}</code>
      <button class="copy" type="button" data-copy="#close-cmd"><span data-label>Copy</span></button>
    </span>
    <a class="textlink" href="/browse">Browse the library <span aria-hidden="true">→</span></a>
  </section>
</Base>

<style>
  /* faq + bio */
  .faq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: clamp(24px, 4vw, 64px); padding-block: clamp(64px, 8vw, 120px); border-top: 1px solid var(--line); }
  .faq-head { display: flex; flex-direction: column; gap: 12px; }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-item summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 16px; padding: 18px 0; font-size: 17px; font-weight: 500; color: var(--ink); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: "+"; font-family: var(--mono); color: var(--ink-3); transition: transform var(--t-med) var(--ease-out); }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { padding: 0 0 20px; max-width: 62ch; color: var(--ink-2); font-size: 16px; line-height: 1.6; }
  .bio { display: flex; flex-direction: column; gap: 12px; padding-block: clamp(48px, 6vw, 88px); border-top: 1px solid var(--line); }
  .bio .h3 a { color: var(--ink); }
  .bio .h3 a:hover { color: var(--accent); }
  .bio-text { max-width: 60ch; color: var(--ink-2); font-size: 17px; line-height: 1.6; }
  .bio-links { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 14px; }
  .bio-links a { color: var(--ink-2); border-bottom: 1px solid var(--line-2); }
  .bio-links a:hover { color: var(--ink); }
  @media (max-width: 860px) { .faq { grid-template-columns: 1fr; } }

  /* hero */
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 4vw, 64px); align-items: center; padding: clamp(40px, 5vw, 72px) 0 clamp(48px, 6vw, 96px); min-height: min(calc(100dvh - var(--header-h)), 820px); }
  .hero-text { display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  .hero .h1 { font-size: clamp(40px, 4.4vw, 66px); line-height: 1.04; max-width: 15ch; }
  .hero .lede { max-width: 42ch; }
  .hero-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; margin-top: 6px; }
  .textlink { font-size: 15px; font-weight: 500; color: var(--ink); border-bottom: 1px solid var(--line-2); padding-bottom: 2px; transition: color var(--t-fast), border-color var(--t-fast); }
  .textlink:hover { color: var(--accent); border-color: var(--accent); }
  .textlink span { display: inline-block; transition: transform var(--t-med) var(--ease-out); }
  .textlink:hover span { transform: translateX(3px); }

  .cmd { display: flex; align-items: center; gap: 10px; width: 100%; max-width: 520px; min-width: 0; padding: 7px 7px 7px 16px; border: 1px solid var(--line-2); border-radius: 12px; background: var(--paper); box-shadow: 0 1px 2px rgba(24, 24, 27, .04); }
  .cmd code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; font-family: var(--mono); font-size: 14px; color: var(--ink); scrollbar-width: none; }
  .cmd .prompt { color: var(--accent); font-size: 14px; }
  .cmd .copy { flex: none; height: 38px; padding: 0 16px; border-radius: 8px; font-size: 14px; font-weight: 500; background: var(--ink); color: var(--paper); transition: opacity var(--t-fast), transform var(--t-fast); }
  .cmd .copy:hover { opacity: .86; }
  .cmd .copy:active { transform: scale(.97); }
  .cmd .copy[data-done] { background: var(--accent); color: var(--accent-ink); }

  .hero-wall { position: relative; aspect-ratio: 1 / 0.92; }
  .wall-item { position: absolute; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--paper-2); overflow: hidden; transition: transform var(--t-slow) var(--ease-out), border-color var(--t-med), box-shadow var(--t-med); }
  .wall-item :global(lounge-frame) { position: absolute; inset: 12px; }
  .wall-item:hover { border-color: var(--line-2); box-shadow: var(--shadow); z-index: 5; transform: translateY(-6px); }
  .wall-item.web { left: 0; top: 0; width: 78%; aspect-ratio: 16 / 10.5; }
  .wall-item.phone { right: 0; top: 14%; width: 27%; aspect-ratio: 9 / 19; }
  .wall-item.phone :global(lounge-frame) { inset: 6px; }
  .wall-item.tablet { left: 12%; top: 56%; width: 54%; aspect-ratio: 16 / 11.3; }

  /* shared block head */
  .block-head { display: flex; flex-direction: column; gap: 14px; max-width: 760px; margin-bottom: clamp(32px, 4vw, 52px); }
  .block-head .h2 { max-width: 20ch; }

  /* library bento */
  .lib { padding-block: clamp(64px, 8vw, 120px); border-top: 1px solid var(--line); }
  .bento { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(220px, auto)) auto; gap: 12px; }
  .cell { position: relative; display: flex; flex-direction: column; gap: 16px; min-width: 0; padding: 22px; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--paper); overflow: hidden; transition: border-color var(--t-med) var(--ease), transform var(--t-med) var(--ease-out), box-shadow var(--t-med) var(--ease); }
  a.cell:hover { border-color: var(--line-2); transform: translateY(-3px); box-shadow: var(--shadow); }
  a.cell:active { transform: translateY(-1px) scale(.995); }
  .cell-text { display: flex; flex-direction: column; gap: 6px; position: relative; z-index: 1; }
  .cell-text p { color: var(--ink-2); font-size: 14.5px; line-height: 1.5; max-width: 34ch; }
  .cell-n { font-family: var(--mono); font-size: 13px; color: var(--ink-3); }
  .cell-h { font-size: 20px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.2; }
  .cell-stage { position: relative; flex: 1; min-height: 160px; margin: 0 -22px -22px; border-top: 1px solid var(--line); background: var(--paper-2) radial-gradient(var(--line-2) 1px, transparent 1.2px) center / 16px 16px; }
  .cell-stage :global(lounge-frame) { position: absolute; inset: 20px 20px 0; }
  .cell-stage.phone :global(lounge-frame) { inset: 18px 22% -40% 22%; }
  .cell-stage.small :global(lounge-frame) { inset: 14px 14px 0; }

  .c-sections { grid-column: 1 / 3; grid-row: 1 / 3; }
  .c-sections .cell-stage { min-height: 320px; }
  .c-screens { grid-column: 3; grid-row: 1 / 3; }
  .c-screens .cell-stage { min-height: 300px; }
  .c-motion { grid-column: 4; grid-row: 1; }
  .c-components { grid-column: 4; grid-row: 2; background: var(--accent-soft); border-color: transparent; }
  .c-components .cell-n { color: var(--accent); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; }
  .tags li { font-size: 12.5px; padding: 4px 10px; border-radius: 999px; background: color-mix(in srgb, var(--paper) 70%, transparent); color: var(--ink-2); }
  .c-styles { grid-column: 1 / 3; grid-row: 3; flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .style-words { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 4px 14px; max-width: 46%; font-size: 15px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink-3); }
  .style-words li:nth-child(3n + 1) { color: var(--ink); }
  .c-more { grid-column: 3; grid-row: 3; flex-direction: row; padding: 0; gap: 0; }
  .c-more a { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; padding: 22px; transition: background-color var(--t-med) var(--ease); }
  .c-more a + a { border-left: 1px solid var(--line); }
  .c-more a:hover { background: var(--paper-2); }
  .c-system { grid-column: 4; grid-row: 3; background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .c-system .cell-h { font-size: 16px; }
  .c-system .cell-h a:hover { color: var(--accent); }
  .sys { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; margin-top: auto; }
  .sys a { display: flex; flex-direction: column; gap: 2px; font-size: 13px; color: color-mix(in srgb, var(--paper) 70%, transparent); transition: color var(--t-fast); }
  .sys a:hover { color: var(--paper); }
  .sys .cell-n { font-size: 22px; font-family: var(--sans); font-weight: 600; letter-spacing: -0.03em; color: var(--paper); }

  /* skill */
