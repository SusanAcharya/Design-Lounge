---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { THEMES, themeCss, themeFontHref } from '../../data/themes';
import { AUTHOR } from '../../lib/pieces';

export function getStaticPaths() {
  return THEMES.map((t) => ({ params: { id: t.id }, props: { theme: t } }));
}
const { theme: t } = Astro.props;
const css = themeCss(t);
const skip = new Set(['accent', 'accentInk', 'positive']);
const chips = (Object.entries(t.tokens) as [string, string][]).filter(([k]) => !skip.has(k));
const others = THEMES.filter((x) => x.id !== t.id && x.tags.some((tag) => t.tags.includes(tag))).slice(0, 4);
---
<Base title={`${t.name} theme`} description={`${t.name}: ${t.mood} A theme from Design Lounge by ${AUTHOR.name}.`}>
  <link rel="stylesheet" href={themeFontHref(t)} />
  <PageHead eyebrow="Theme" title={t.name} />
  <div class="wrap page">
    <section class="hero" style={`background:${t.tokens.bg};color:${t.tokens.ink};border-color:${t.tokens.line}`}>
      <p class="mono" style={`color:${t.tokens.primary}`}>{t.display} + {t.text}</p>
      <h2 class="display h1" style={`font-family:"${t.display}", Georgia, serif`}>{t.specimen}</h2>
      <p style={`font-family:"${t.text}", system-ui, sans-serif;color:${t.tokens.ink2}`}>{t.bestFor.join(' · ')}</p>
      <div class="acts">
        <span class="btn" style={`background:${t.tokens.primary};color:${t.tokens.primaryInk};border-color:${t.tokens.primary}`}>Primary</span>
        <span class="btn" style={`background:${t.tokens.secondary};color:${t.tokens.secondaryInk};border-color:${t.tokens.secondary}`}>Secondary</span>
        <span class="btn" style={`background:${t.tokens.tertiarySoft};color:${t.tokens.tertiary};border-color:${t.tokens.tertiarySoft}`}>Tertiary</span>
      </div>
    </section>
    <aside>
      <ol class="chips">
        {chips.map(([k, v]) => (
          <li>
            <i style={`background:${v}`}></i>
            <span class="mono">{k}</span>
            <code>{v}</code>
          </li>
        ))}
      </ol>
      <button class="btn primary" type="button" data-copy="#theme-css"><span data-label>Copy CSS</span></button>
      <p class="mono faint">Theme by {AUTHOR.name}. Free to use; credit appreciated.</p>
    </aside>
    <script type="application/json" id="theme-css" set:html={JSON.stringify(css)}></script>
    <section class="css">
      <div class="section-head"><div><span class="eyebrow">Tokens</span><h3 class="display h4">The theme as CSS</h3></div></div>
      <pre><code>{css}</code></pre>
    </section>
    {others.length > 0 && (
      <nav class="more">
        <p class="eyebrow">Nearby themes</p>
        <ul>{others.map((o) => <li><a href={`/themes/${o.id}`}>{o.name}</a></li>)}</ul>
      </nav>
    )}
  </div>
</Base>

<style>
  .page { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(260px, .8fr); gap: 32px; margin-top: 36px; }
  .hero { padding: clamp(32px, 5vw, 64px); border: 1px solid; border-radius: var(--r-lg); min-height: 340px; display: flex; flex-direction: column; gap: 18px; }
  .hero .h1 { font-size: clamp(40px, 6vw, 72px); }
  .acts { display: flex; gap: 10px; margin-top: auto; }
  .chips { display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px; }
  .chips li { display: grid; grid-template-columns: 22px 1fr auto; gap: 10px; align-items: center; }
  .chips i { width: 22px; height: 22px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(0,0,0,.12); }
  .chips .mono { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-3); }
  .chips code { font-size: 12px; }
  aside { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .css { grid-column: 1 / -1; }
  pre { background: var(--paper-2); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 18px; overflow: auto; font-size: 12.5px; line-height: 1.55; }
  .more { grid-column: 1 / -1; display: flex; gap: 16px; flex-wrap: wrap; align-items: center; border-top: 1px solid var(--line); padding-top: 14px; }
  .more ul { display: flex; gap: 10px 18px; flex-wrap: wrap; }
  .more a { border-bottom: 1px solid var(--line-2); }
  @media (max-width: 800px) { .page { grid-template-columns: minmax(0, 1fr); } }
</style>
