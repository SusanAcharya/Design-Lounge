---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Catalog from '../../components/Catalog.astro';
import { getPieces, CATEGORY_META, CATEGORY_GROUPS, type Category } from '../../lib/pieces';

export async function getStaticPaths() {
  return Object.keys(CATEGORY_META).map((category) => ({ params: { category } }));
}
const category = Astro.params.category as Category;
const meta = CATEGORY_META[category];
const all = await getPieces();
const pieces = all.filter((p) => p.data.category === category);
const group = CATEGORY_GROUPS.find((g) => g.items.includes(category))!;
const siblings = group.items.filter((c) => c !== category).map((c) => ({ c, n: all.filter((p) => p.data.category === c).length })).filter((s) => s.n > 0);
---
<Base title={`${meta.label}: ${pieces.length} UI design ideas`} description={`${pieces.length} ${meta.label.toLowerCase()} designs with live demos and briefs your AI agent can build. ${meta.blurb}`} crumbs={[{ name: 'Index', href: '/sections' }, { name: meta.label, href: `/sections/${category}` }]}>
  <PageHead eyebrow={group.label} title={meta.label} count={pieces.length}>
    <nav class="sibs" aria-label={`More ${group.label.toLowerCase()}`}>
      <a class="eyebrow" href="/sections">All categories</a>
      {siblings.map((s) => <a class="chip" href={`/sections/${s.c}`}>{CATEGORY_META[s.c].label} <span class="cnt">{s.n}</span></a>)}
    </nav>
  </PageHead>
  <div class="wrap">
    {pieces.length ? <Catalog pieces={pieces} all={all} seed="all" /> : <p class="empty lede">Nothing on this shelf yet. New pieces land here first.</p>}
  </div>
</Base>

<style>
  .sibs { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 8px; }
  .sibs .eyebrow { margin-right: 6px; border-bottom: 1px solid var(--line-2); padding-bottom: 1px; }
  .sibs .eyebrow:hover { color: var(--ink); border-color: var(--ink); }
  .cnt { color: var(--ink-2); font-size: 12px; }
  .empty { padding: 64px 0; }
</style>
