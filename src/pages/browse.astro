---
import Base from '../layouts/Base.astro';
import Catalog from '../components/Catalog.astro';
import { getPieces } from '../lib/pieces';
const pieces = await getPieces();
---
<Base title="Browse the library" description="Every piece in the Lounge: screens, components, animations, layouts, patterns and styles for web, mobile, tablet, app and PWA." rail={false}>
  <header class="bh wrap">
    <h1 class="display h3">Library</h1>
    <p class="muted">{pieces.length} live pieces. Narrow by type, platform, section or style, then open one to see it live and copy its brief.</p>
  </header>
  <div class="wrap">
    <Catalog pieces={pieces} all={pieces} sidebar />
  </div>
</Base>

<style>
  .bh { display: flex; align-items: baseline; gap: 8px 20px; flex-wrap: wrap; padding: clamp(24px, 3vw, 36px) 0 6px; }
  .bh .h3 { font-weight: 600; }
  .bh p { font-size: 14.5px; max-width: 70ch; }
</style>
