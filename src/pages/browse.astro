---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Catalog from '../components/Catalog.astro';
import { getPieces } from '../lib/pieces';
import { MAP } from '../data/starts';
const pieces = await getPieces();
---
<Base title="The floor" description="Every piece in the Lounge: screens, components, animations, layouts, patterns and styles for web, mobile, tablet, app and PWA.">
  <PageHead eyebrow="Browse" title="Browse" count={pieces.length} blurb="Every piece. Search, or use Filter. Open one to see it live and copy its brief." />
  <nav class="map wrap" aria-label="Other ways in">
    {MAP.filter((m) => m.href !== '/browse').map((m) => (
      <a href={m.href}>{m.kicker}</a>
    ))}
  </nav>
  <div class="wrap">
    <Catalog pieces={pieces} all={pieces} />
  </div>
</Base>

<style>
  .map { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); margin-top: 28px; }
  .map a { display: flex; flex-direction: column; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .map a + a { padding-left: 20px; }
  .map a:hover { color: var(--accent); }
  @media (max-width: 640px) { .map { grid-template-columns: minmax(0, 1fr); } .map a + a { padding-left: 0; } }
</style>
