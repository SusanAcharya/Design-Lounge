---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Catalog from '../../components/Catalog.astro';
import { getPieces, TYPE_META, type PieceType } from '../../lib/pieces';

export async function getStaticPaths() {
  return Object.keys(TYPE_META).map((type) => ({ params: { type } }));
}
const type = Astro.params.type as PieceType;
const meta = TYPE_META[type];
const all = await getPieces();
const pieces = all.filter((p) => p.data.type === type);
const others = Object.entries(TYPE_META).filter(([k]) => k !== type);
---
<Base title={meta.label} description={`${meta.label} in the Design Lounge: ${meta.blurb}`}>
  <PageHead eyebrow="Room" title={meta.label} count={pieces.length}>
    <nav class="rooms" aria-label="Other rooms">
      <span class="eyebrow">Other rooms</span>
      {others.map(([k, v]) => <a class="chip" href={`/rooms/${k}`}>{v.label} <span class="cnt">{all.filter((p) => p.data.type === k).length}</span></a>)}
    </nav>
  </PageHead>
  <div class="wrap">
    <Catalog pieces={pieces} all={all} lock={{ type }} />
  </div>
</Base>

<style>
  .rooms { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 8px; }
  .rooms .eyebrow { margin-right: 6px; }
  .cnt { opacity: .55; }
</style>
