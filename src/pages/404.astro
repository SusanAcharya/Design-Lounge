---
import Base from '../layouts/Base.astro';
---
<Base title="Not on the floor">
  <div class="wrap nf">
    <p class="eyebrow">404</p>
    <h1 class="display h1">That seat is <i>empty.</i></h1>
    <p class="lede">Whatever was here has been moved, renamed, or never existed. The floor is still open.</p>
    <div class="acts">
      <a class="btn primary" href="/browse">Browse everything</a>
      <a class="btn" href="/random" data-random>Surprise me</a>
    </div>
  </div>
</Base>
<style>
  .nf { padding: clamp(64px, 12vw, 160px) 0; display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .acts { display: flex; gap: 10px; margin-top: 12px; }
</style>
