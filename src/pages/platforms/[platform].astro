---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Catalog from '../../components/Catalog.astro';
import { getPieces, PLATFORM_META, type Platform } from '../../lib/pieces';

export async function getStaticPaths() {
  return Object.keys(PLATFORM_META).map((platform) => ({ params: { platform } }));
}
const platform = Astro.params.platform as Platform;
const meta = PLATFORM_META[platform];
const all = await getPieces();
const pieces = all.filter((p) => p.data.platform === platform);
const others = Object.entries(PLATFORM_META).filter(([k]) => k !== platform);
---
<Base title={meta.label} description={`${meta.label} pieces in the Design Lounge. ${meta.blurb}`}>
  <PageHead eyebrow="Platform" title={meta.label} count={pieces.length}>
    <nav class="rooms" aria-label="Other platforms">
      <span class="eyebrow">Other platforms</span>
      {others.map(([k, v]) => <a class="chip" href={`/platforms/${k}`}>{v.label} <span class="cnt">{all.filter((p) => p.data.platform === k).length}</span></a>)}
    </nav>
  </PageHead>
  <div class="wrap">
    <Catalog pieces={pieces} all={all} lock={{ platform }} />
  </div>
</Base>

<style>
  .rooms { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-top: 8px; }
  .rooms .eyebrow { margin-right: 6px; }
  .cnt { opacity: .55; }
</style>
