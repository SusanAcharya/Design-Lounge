---
// Index tiles for /rooms, /platforms and /styles: each tile shows its sample piece's poster, not a live frame.
// A full device frame per tile put about 70 elements of chrome in every tile and 1.3 s of style and layout
// on the page; a poster is one image, and the pieces themselves are one click away.
import { cardPoster } from '../lib/posters';
import type { Piece } from '../lib/pieces';

interface Props {
  items: { key: string; label: string; blurb: string; href: string; count: number; sample?: Piece }[];
}
const { items } = Astro.props;
const PHONE = new Set(['mobile-web', 'mobile-app', 'pwa']);
---
<ol class="tiles">
  {items.map((it, i) => {
    const poster = it.sample ? cardPoster(it.sample.id, it.sample.data.platform) : { src: '', tall: false };
    const phone = it.sample ? PHONE.has(it.sample.data.platform) : false;
    return (
      <li class="tile reveal" style={`--d:${i * 40}ms`}>
        <a href={it.href}>
          <div class:list={['tile-pre', { phone }]} aria-hidden="true">
            {poster.src && (
              <img
                src={poster.src}
                alt=""
                width={phone ? 390 : 640}
                height={phone ? 844 : 480}
                decoding="async"
                loading={i < 3 ? 'eager' : 'lazy'}
                fetchpriority={i < 3 ? 'high' : 'auto'}
              />
            )}
          </div>
          <div class="tile-text">
            <span class="display n num">{String(it.count).padStart(2, '0')}</span>
            <span class="display h4">{it.label}</span>
          </div>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-top: 32px; }
  .tile { content-visibility: auto; contain-intrinsic-size: auto 320px; }
  .tile a { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; height: 100%; transition: border-color var(--t-fast), transform var(--t-med) var(--ease), box-shadow var(--t-med); }
  .tile a:hover { border-color: var(--ink-3); transform: translateY(-2px); box-shadow: var(--shadow); }
  .tile-pre { aspect-ratio: 16 / 10; background: var(--paper-2); background-image: radial-gradient(var(--line) 1px, transparent 1px); background-size: 14px 14px; position: relative; border-bottom: 1px solid var(--line); overflow: hidden; }
  .tile-pre img { position: absolute; inset: 12px; width: calc(100% - 24px); height: calc(100% - 24px); object-fit: cover; object-position: top; border-radius: 6px; border: 1px solid var(--line); background: var(--paper); }
  .tile-pre.phone img { inset: 12px auto 12px 50%; width: auto; height: calc(100% - 24px); aspect-ratio: 390 / 844; transform: translateX(-50%); object-fit: cover; }
  .tile-text { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px 18px; }
  .tile-text .n { font-size: 30px; line-height: 1; color: var(--ink-3); }
  .tile-text .muted { font-size: 14px; text-wrap: pretty; }
</style>
