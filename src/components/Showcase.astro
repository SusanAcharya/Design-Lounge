---
import { existsSync } from 'node:fs';
import DeviceFrame from './DeviceFrame.astro';
import { getPieces, numberMap, PLATFORM_META } from '../lib/pieces';

interface Props {
  id: string;
  n?: string;
  kicker: string;
  slugs: { slug: string; label: string }[];
  flip?: boolean;
  more: { href: string; label: string };
  note?: string;
}
const { id, n, kicker, slugs, flip = false, more, note } = Astro.props;
const all = await getPieces();
const nums = numberMap(all);
const items = slugs
  .map(({ slug, label }) => {
    const p = all.find((x) => x.id === slug);
    if (!p) return null;
    const thumbWebp = new URL(`../../public/thumbs/${slug}.webp`, import.meta.url);
    const thumbJpg = new URL(`../../public/thumbs/${slug}.jpg`, import.meta.url);
    const thumb = existsSync(thumbWebp) ? `/thumbs/${slug}.webp` : existsSync(thumbJpg) ? `/thumbs/${slug}.jpg` : '';
    return { slug, label, title: p.data.title, summary: p.data.summary, platform: p.data.platform, n: nums.get(slug) ?? '000', thumb };
  })
  .filter((x): x is NonNullable<typeof x> => !!x);
const first = items[0];
const frame = first ? PLATFORM_META[first.platform].frame : 'web';
const prompt = (title: string, slug: string) => `Use the Design Lounge skill. Build "${title}" (piece ${slug}) for my product: read its brief, keep its palette and type, and swap in my content.`;
---
{first && (
<section class:list={['sc', 'wrap', `sc-${frame}`, { flip }]} id={id} aria-labelledby={`${id}-h`} data-showcase>
  <div class="sc-text">
    {n && <p class="sc-n mono"><span>Nº {n}</span><span class="rule" aria-hidden="true"></span><span>{kicker}</span></p>}
    <h2 class="display sc-h" id={`${id}-h`}><slot name="title" /></h2>
    <p class="sc-copy"><slot /></p>

    <div class="sc-list" role="tablist" aria-label={`${kicker}: choose a piece`} aria-orientation="vertical">
      {items.map((it, i) => (
        <button
          type="button"
          role="tab"
          id={`${id}-tab-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`${id}-stage`}
          tabindex={i === 0 ? 0 : -1}
          data-slug={it.slug}
          data-title={it.title}
          data-summary={it.summary}
          data-n={it.n}
          data-thumb={it.thumb}
          data-prompt={prompt(it.title, it.slug)}
        >
          <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
          <span class="lbl">{it.label}</span>
        </button>
      ))}
    </div>

    <div class="sc-meta">
      <p class="sc-pn mono faint">Piece Nº <span data-f="n">{first.n}</span></p>
      <p class="sc-title display" data-f="title">{first.title}</p>
      <p class="sc-sum" data-f="summary">{first.summary}</p>
      <div class="sc-acts">
        <a class="btn sm" data-f="open" href={`/p/${first.slug}`}>Open</a>
        <button class="btn sm ghost" type="button" data-sc-copy><span data-label>Copy prompt</span></button>
        <a class="sc-more mono" href={more.href}>{more.label} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <div class="sc-stage-wrap">
    <div class="sc-stage" id={`${id}-stage`} role="tabpanel" aria-labelledby={`${id}-tab-0`}>
      <span class="sc-live" aria-hidden="true"><i></i>Live, try it</span>
      <DeviceFrame slug={first.slug} platform={first.platform} title={first.title} interactive />
    </div>
    {note && <p class="sc-note mono faint">{note}</p>}
  </div>
</section>
)}

<script>
  type Frame = HTMLElement & { reload?: () => void };

  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((sec) => {
    const tabs = [...sec.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const stage = sec.querySelector<HTMLElement>('[role="tabpanel"]')!;
    const frame = stage.querySelector<Frame>('lounge-frame')!;
    const f = (k: string) => sec.querySelector<HTMLElement>(`[data-f="${k}"]`)!;
    const copyBtn = sec.querySelector<HTMLButtonElement>('[data-sc-copy]')!;
    let current = tabs[0];

    function select(tab: HTMLButtonElement, focus = false) {
      if (focus) tab.focus();
      if (tab === current) return;
      current = tab;
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      stage.setAttribute('aria-labelledby', tab.id);
      const { slug = '', title = '', summary = '', n = '', thumb = '' } = tab.dataset;
      f('n').textContent = n;
      f('title').textContent = title;
      f('summary').textContent = summary;
      f('open').setAttribute('href', `/p/${slug}`);
      sec.classList.remove('swap'); void sec.offsetWidth; sec.classList.add('swap');

      frame.querySelectorAll('.lf-url .path').forEach((e) => { e.textContent = slug; });
      frame.querySelectorAll('.lf-tab .t').forEach((e) => { e.textContent = title; });
      frame.querySelectorAll('.lf-chrome > .url').forEach((e) => { e.textContent = `designlounge.live/${slug}`; });
      const iframe = frame.querySelector('iframe');
      iframe?.setAttribute('title', `Live preview: ${title}`);
      const img = frame.querySelector<HTMLImageElement>('.lf-poster-img');
      if (img) { if (thumb) { img.src = thumb; img.hidden = false; } else img.hidden = true; }
      frame.dataset.src = `/demo/${slug}.html`;
      if (frame.reload) frame.reload();
      else if (iframe) iframe.src = frame.dataset.src;
    }

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        let j = -1;
        if (k === 'ArrowDown' || k === 'ArrowRight') j = (i + 1) % tabs.length;
        else if (k === 'ArrowUp' || k === 'ArrowLeft') j = (i - 1 + tabs.length) % tabs.length;
        else if (k === 'Home') j = 0;
        else if (k === 'End') j = tabs.length - 1;
        if (j < 0) return;
        e.preventDefault();
        select(tabs[j], true);
        tabs[j].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      });
    });

    copyBtn.addEventListener('click', async () => {
      const text = current.dataset.prompt || '';
      try { await navigator.clipboard.writeText(text); } catch {
        const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
      }
      const label = copyBtn.querySelector('[data-label]')!;
      copyBtn.setAttribute('data-done', '');
      label.textContent = 'Copied';
      setTimeout(() => { copyBtn.removeAttribute('data-done'); label.textContent = 'Copy prompt'; }, 1600);
    });
  });
</script>

<style>
  .sc {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px);
    align-items: center; padding-block: clamp(44px, 5.5vw, 80px);
  }
  .sc.flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .sc-web, .sc-tablet { grid-template-columns: minmax(0, 9fr) minmax(0, 16fr); }
  .sc-web.flip, .sc-tablet.flip { grid-template-columns: minmax(0, 16fr) minmax(0, 9fr); }
  .sc.flip .sc-text { order: 2; }
  .sc-text { display: flex; flex-direction: column; gap: 20px; min-width: 0; }

  .sc-n { display: flex; align-items: center; gap: 12px; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }
  .sc-n .rule { width: 36px; height: 1px; background: var(--ink-3); }
  .sc-h { font-size: clamp(30px, 3vw, 46px); line-height: 1.06; text-wrap: balance; max-width: 16ch; }
  .sc-copy { color: var(--ink-2); font-size: 16.5px; line-height: 1.55; max-width: 42ch; text-wrap: pretty; }

  .sc-list { display: flex; flex-direction: column; border-top: 1px solid var(--line-2); margin-top: 8px; }
  .sc-list [role="tab"] {
    position: relative; display: grid; grid-template-columns: 36px 1fr; align-items: baseline; gap: 8px;
    padding: 11px 4px 11px 0; border-bottom: 1px solid var(--line); text-align: left; color: var(--ink-2);
    font-size: 15px; transition: color var(--t-fast), padding-left var(--t-med) var(--ease);
  }
  .sc-list [role="tab"] .num { font-size: 11px; color: var(--ink-3); letter-spacing: .06em; }
  .sc-list [role="tab"]::after {
    content: ""; position: absolute; right: 2px; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%;
    background: var(--accent); transform: scale(0); transition: transform var(--t-med) var(--ease-out);
  }
  .sc-list [role="tab"]:hover { color: var(--ink); }
  .sc-list [role="tab"][aria-selected="true"] { color: var(--ink); padding-left: 8px; }
  .sc-list [role="tab"][aria-selected="true"] .num { color: var(--accent-text); }
  .sc-list [role="tab"][aria-selected="true"]::after { transform: scale(1); }
  .sc-list [role="tab"]:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

  .sc-meta { display: flex; flex-direction: column; gap: 6px; min-height: 150px; }
  .sc-pn { font-size: 11px; }
  .sc-title { font-size: 20px; line-height: 1.25; }
  .sc-sum { color: var(--ink-2); font-size: 14px; line-height: 1.5; max-width: 52ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .sc.swap .sc-meta > :is(.sc-title, .sc-sum, .sc-pn) { animation: sc-in var(--t-slow) var(--ease-out); }
  @keyframes sc-in { from { opacity: 0; transform: translateY(6px); } }
  .sc-acts { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 10px; margin-top: 8px; }
  .sc-acts [data-done] { border-color: var(--accent-text); color: var(--accent-text); }
  .sc-more { margin-left: auto; font-size: 14px; font-weight: 500; color: var(--ink); border-bottom: 1px solid var(--ink-3); padding-bottom: 2px; transition: color var(--t-fast), border-color var(--t-fast); }
  .sc-more:hover { color: var(--accent-text); border-color: var(--accent-text); }

  .sc-stage-wrap { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .sc-stage {
    position: relative; border: 1px solid var(--line); border-radius: var(--r-lg);
    background: var(--paper-2) radial-gradient(var(--line-2) 1px, transparent 1.2px) center / 16px 16px;
    overflow: hidden;
  }
  .sc-stage :global(lounge-frame) { position: absolute; inset: 28px; }
  .sc-web .sc-stage { aspect-ratio: 1280 / 900; }
  .sc-tablet .sc-stage { aspect-ratio: 1216 / 900; }
  .sc-phone .sc-stage { height: min(84vh, 800px); }
  .sc-phone .sc-stage :global(lounge-frame) { inset: 36px 24px; }
  .sc-live {
    position: absolute; left: 14px; top: 12px; z-index: 2; display: inline-flex; align-items: center; gap: 7px;
    font-size: 12px; font-weight: 500; color: var(--ink-2);
  }
  .sc-live i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: sc-pulse 2.4s var(--ease) infinite; }
  @keyframes sc-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
  .sc-web .sc-live, .sc-tablet .sc-live { top: 6px; }
  .sc-web .sc-stage :global(lounge-frame), .sc-tablet .sc-stage :global(lounge-frame) { inset: 32px 22px 20px; }
  .sc-note { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; text-align: right; }

  @media (max-width: 960px) {
    .sc, .sc.flip { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-block: 56px; }
    .sc.flip .sc-text { order: 0; }
    .sc-h { max-width: 18ch; }
  }
  @media (max-width: 760px) {
    .sc-text { display: contents; }
    .sc { gap: 18px; }
    .sc-n { order: 1; } .sc-h { order: 2; } .sc-copy { order: 3; }
    .sc-list { order: 4; }
    .sc-stage-wrap { order: 5; }
    .sc-meta { order: 6; min-height: 0; }
    .sc-h { font-size: clamp(32px, 9vw, 40px); }
    .sc-copy { font-size: 15.5px; }
    .sc-list {
      flex-direction: row; gap: 6px; overflow-x: auto; border-top: 0; margin: 0 calc(-1 * var(--gutter)); padding: 2px var(--gutter);
      scrollbar-width: none; scroll-snap-type: x proximity; scroll-padding-inline: var(--gutter);
    }
    .sc-list::-webkit-scrollbar { display: none; }
    .sc-list [role="tab"] {
      flex: none; display: inline-flex; gap: 6px; align-items: center; padding: 8px 12px; border: 1px solid var(--line); border-radius: 999px;
      font-size: 13.5px; white-space: nowrap; scroll-snap-align: start;
    }
    .sc-list [role="tab"]::after { display: none; }
    .sc-list [role="tab"][aria-selected="true"] { padding-left: 12px; background: var(--ink); color: var(--paper); border-color: var(--ink); }
    .sc-list [role="tab"][aria-selected="true"] .num { color: var(--accent-on-ink); }
    .sc-phone .sc-stage { height: 70vh; min-height: 520px; }
    .sc-phone .sc-stage :global(lounge-frame) { inset: 32px 12px 14px; }
    .sc-web .sc-stage :global(lounge-frame), .sc-tablet .sc-stage :global(lounge-frame) { inset: 24px 10px 10px; }
    .sc-web .sc-stage, .sc-tablet .sc-stage { aspect-ratio: 1280 / 980; }
    .sc-more { margin-left: 0; width: 100%; padding-top: 6px; border: 0; }
    .sc-note { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc-live i { animation: none; }
    .sc.swap .sc-meta > * { animation: none; }
  }
</style>
