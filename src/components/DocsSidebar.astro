---
import { CATEGORY_GROUPS, CATEGORY_META, type Piece } from '../lib/pieces';

interface Props {
  pieces: Piece[];
  current: string;
}
const { pieces, current } = Astro.props;
const DAY = 86_400_000;
const newest = Math.max(...pieces.map((p) => p.data.published.getTime()));
const inWindow = (p: Piece) => newest - p.data.published.getTime() <= 10 * DAY;
// A badge on most of the list says nothing, so a crowded window narrows to the newest day.
const isNew = pieces.filter(inWindow).length > pieces.length / 4 ? (p: Piece) => p.data.published.getTime() === newest : inWindow;
const currentCat = pieces.find((p) => p.id === current)?.data.category;
const groups = CATEGORY_GROUPS.map((g) => ({
  ...g,
  cats: g.items
    .map((c) => ({ id: c, label: CATEGORY_META[c].label, items: pieces.filter((p) => p.data.category === c).sort((a, b) => a.data.title.localeCompare(b.data.title)) }))
    .filter((c) => c.items.length),
})).filter((g) => g.cats.length);
---
<div class="ds-scrim" data-ds-scrim hidden></div>
<nav class="ds" id="all-pieces" aria-label="All pieces" data-ds>
  <div class="ds-top">
    <div class="ds-head">
      <span class="eyebrow">All pieces <span class="num">{pieces.length}</span></span>
      <button class="ds-close" type="button" data-ds-close aria-label="Close all pieces">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <label class="ds-filter">
      <span class="sr-only">Filter pieces</span>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input type="search" placeholder="Filter pieces" autocomplete="off" spellcheck="false" data-ds-filter />
    </label>
  </div>
  <div class="ds-scroll" data-ds-scroll>
    {groups.map((g) => (
      <section class="ds-group" aria-label={g.label}>
        <p class="ds-glabel">{g.label}</p>
        {g.cats.map((c) => (
          <details class="ds-cat" open data-ds-cat>
            <summary>
              <svg class="chev" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
              <span class="lbl">{c.label}</span>
              <span class="cnt num" data-ds-count>{c.items.length}</span>
            </summary>
            <ul>
              {c.items.map((p) => (
                <li data-ds-item data-k={`${p.data.title} ${p.id} ${c.label} ${p.data.tags.join(' ')}`.toLowerCase()}>
                  <a href={`/p/${p.id}`} aria-current={p.id === current ? 'page' : undefined}>
                    <span class="t">{p.data.title}</span>
                    {isNew(p) && <span class="new">New</span>}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </section>
    ))}
    <p class="ds-empty mono faint" data-ds-empty hidden>No pieces match.</p>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-ds]');
  if (nav) {
    const scroller = nav.querySelector<HTMLElement>('[data-ds-scroll]')!;
    const input = nav.querySelector<HTMLInputElement>('[data-ds-filter]')!;
    const empty = nav.querySelector<HTMLElement>('[data-ds-empty]')!;
    const cats = [...nav.querySelectorAll<HTMLDetailsElement>('[data-ds-cat]')];
    const scrim = document.querySelector<HTMLElement>('[data-ds-scrim]')!;
    const openers = [...document.querySelectorAll<HTMLButtonElement>('[data-ds-open]')];

    const cur = nav.querySelector<HTMLElement>('a[aria-current="page"]');
    const centre = () => {
      if (!cur) return;
      const top = cur.getBoundingClientRect().top - scroller.getBoundingClientRect().top + scroller.scrollTop;
      scroller.scrollTop = Math.max(0, top - scroller.clientHeight / 3);
    };
    centre();

    const userOpen = new Map(cats.map((c) => [c, c.open]));
    cats.forEach((c) => c.addEventListener('toggle', () => { if (!input.value.trim()) userOpen.set(c, c.open); }));
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let total = 0;
      cats.forEach((c) => {
        let n = 0;
        c.querySelectorAll<HTMLElement>('[data-ds-item]').forEach((li) => {
          const hit = !q || q.split(/\s+/).every((w) => li.dataset.k!.includes(w));
          li.hidden = !hit;
          if (hit) n++;
        });
        c.querySelector('[data-ds-count]')!.textContent = String(n);
        c.hidden = n === 0;
        c.open = q ? n > 0 : userOpen.get(c)!;
        total += n;
      });
      nav.querySelectorAll<HTMLElement>('.ds-group').forEach((g) => { g.hidden = !g.querySelector('[data-ds-cat]:not([hidden])'); });
      empty.hidden = total > 0;
      if (!q) centre(); else scroller.scrollTop = 0;
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && input.value) { e.stopPropagation(); input.value = ''; input.dispatchEvent(new Event('input')); }
    });

    // Drawer below 1024px
    const mq = matchMedia('(max-width: 1023.98px)');
    let last: HTMLElement | null = null;
    const focusables = () => [...nav.querySelectorAll<HTMLElement>('button, input, summary, a[href]')].filter((el) => el.offsetParent !== null);
    // <main> is its own stacking context under the sticky header, so the open drawer lives on <body>.
    const home = document.createComment('all-pieces');
    nav.before(home);
    function open() {
      last = document.activeElement as HTMLElement;
      document.body.append(scrim, nav);
      scrim.hidden = false;
      nav.classList.add('open');
      nav.setAttribute('role', 'dialog');
      nav.setAttribute('aria-modal', 'true');
      document.documentElement.classList.add('ds-lock');
      openers.forEach((b) => b.setAttribute('aria-expanded', 'true'));
      requestAnimationFrame(() => { centre(); input.focus({ preventScroll: true }); });
    }
    function close() {
      if (!nav.classList.contains('open')) return;
      nav.classList.remove('open');
      nav.removeAttribute('role');
      nav.removeAttribute('aria-modal');
      scrim.hidden = true;
      document.documentElement.classList.remove('ds-lock');
      openers.forEach((b) => b.setAttribute('aria-expanded', 'false'));
      last?.focus({ preventScroll: true });
      setTimeout(() => { if (!nav!.classList.contains('open')) { home.before(scrim); home.after(nav!); } }, 300);
    }
    openers.forEach((b) => b.addEventListener('click', open));
    nav.querySelector('[data-ds-close]')!.addEventListener('click', close);
    scrim.addEventListener('click', close);
    mq.addEventListener('change', () => { if (!mq.matches) close(); });
    nav.addEventListener('keydown', (e) => {
      if (!nav.classList.contains('open')) return;
      if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); close(); return; }
      if (e.key !== 'Tab') return;
      const f = focusables();
      if (!f.length) return;
      const first = f[0], end = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); end.focus(); }
      else if (!e.shiftKey && document.activeElement === end) { e.preventDefault(); first.focus(); }
    });
  }
</script>

<style>
  .ds { position: sticky; top: var(--stick, 111px); height: calc(100vh - var(--stick, 111px)); height: calc(100dvh - var(--stick, 111px)); display: flex; flex-direction: column; min-width: 0; border-right: 1px solid var(--line); }
  .ds-top { padding: 22px 18px 12px 0; display: flex; flex-direction: column; gap: 12px; }
  .ds-head { display: flex; align-items: center; justify-content: space-between; }
  .ds-head .num { color: var(--ink-2); margin-left: 4px; }
  .ds-close { display: none; width: 32px; height: 32px; border-radius: var(--r); place-items: center; color: var(--ink-2); }
  .ds-close:hover { background: var(--paper-2); color: var(--ink); }
  .ds-close svg, .ds-filter svg, .chev { stroke: currentColor; fill: none; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .ds-filter { display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 10px; border: 1px solid var(--line-2); border-radius: var(--r); color: var(--ink-3); background: var(--paper); transition: border-color var(--t-fast); }
  .ds-filter:focus-within { border-color: var(--ink); color: var(--ink-2); }
  .ds-filter input { flex: 1; min-width: 0; border: 0; background: none; outline: none; font-family: var(--mono); font-size: 12px; letter-spacing: .02em; color: var(--ink); }
  .ds-filter input::placeholder { color: var(--ink-3); }
  .ds-filter input::-webkit-search-cancel-button { filter: grayscale(1); opacity: .5; }
  .ds-scroll { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 4px 14px 40px 0; scrollbar-width: thin; scrollbar-color: var(--line-2) transparent; mask-image: linear-gradient(to bottom, transparent, #000 14px, #000 calc(100% - 28px), transparent); }
  .ds-group + .ds-group { margin-top: 18px; }
  .ds-glabel { font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); padding: 10px 0 6px; }
  .ds-cat summary { list-style: none; display: flex; align-items: center; gap: 6px; padding: 6px 6px 6px 0; cursor: pointer; border-radius: var(--r); font-size: 13.5px; font-weight: 500; color: var(--ink); user-select: none; }
  .ds-cat summary::-webkit-details-marker { display: none; }
  .ds-cat summary:hover .lbl { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-2); }
  .chev { flex: none; color: var(--ink-3); transition: transform var(--t-fast) var(--ease); }
  .ds-cat[open] > summary .chev { transform: rotate(90deg); }
  .lbl { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cnt { font-family: var(--mono); font-size: 12px; color: var(--ink-2); }
  .ds-cat ul { margin: 2px 0 8px 5px; border-left: 1px solid var(--line); }
  .ds-cat li a { position: relative; display: flex; align-items: center; gap: 8px; padding: 5px 8px 5px 13px; margin-left: -1px; border-left: 1px solid transparent; font-size: 13px; line-height: 1.35; color: var(--ink-2); border-radius: 0 var(--r) var(--r) 0; transition: color var(--t-fast), background-color var(--t-fast), border-color var(--t-fast); }
  .ds-cat li a:hover { color: var(--ink); border-left-color: var(--ink-3); }
  .ds-cat li a[aria-current="page"] { color: var(--ink); background: var(--paper-2); border-left: 2px solid var(--accent); padding-left: 12px; font-weight: 500; }
  .ds-cat li a:focus-visible { outline-offset: -2px; }
  .t { flex: 1; min-width: 0; }
  .new { flex: none; font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; line-height: 1; padding: 2px 4px; border-radius: 3px; color: var(--accent-text); border: 1px solid color-mix(in srgb, var(--accent-text) 35%, transparent); }
  .ds-empty { padding: 16px 0; }
  .ds-scrim { position: fixed; inset: 0; z-index: 90; background: color-mix(in srgb, var(--ink) 34%, transparent); backdrop-filter: blur(2px); animation: ds-fade var(--t-med) var(--ease); }
  .ds-scrim[hidden] { display: none; }
  @keyframes ds-fade { from { opacity: 0; } }
  :global(html.ds-lock) { overflow: hidden; }

  @media (max-width: 1023.98px) {
    .ds { position: fixed; top: 0; left: 0; bottom: 0; z-index: 100; width: min(340px, 88vw); height: auto; background: var(--paper); border-right: 1px solid var(--line-2); box-shadow: var(--shadow); padding-left: 18px; transform: translateX(-104%); visibility: hidden; transition: transform var(--t-med) var(--ease-out), visibility 0s linear var(--t-med); }
    .ds.open { transform: none; visibility: visible; transition: transform var(--t-med) var(--ease-out), visibility 0s; }
    .ds-close { display: grid; }
    .ds-top { padding-top: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .ds, .ds.open { transition: none; } .chev { transition: none; } }
</style>
