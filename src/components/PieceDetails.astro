---
import { AUTHOR, MOTION_LABEL, DIFFICULTY_LABEL, type Piece } from '../lib/pieces';

interface Props { data: Piece['data']; class?: string }
const { data: d, class: cls } = Astro.props;
---
<div class:list={['pd', cls]}>
  <div class="pd-box">
    <p class="eyebrow">Details</p>
    <dl>
      <div><dt>Palette</dt><dd class="swl">{d.palette.map((c) => <button type="button" class="sw" data-copy-hex={c} title={`Copy ${c}`} aria-label={`Copy ${c}`}><i style={`background:${c}`}></i><span class="mono">{c}</span></button>)}</dd></div>
      <div><dt>Type</dt><dd>{d.fonts.join(' · ')}</dd></div>
      <div><dt>Motion</dt><dd>{MOTION_LABEL[d.motion]}</dd></div>
      <div><dt>Build</dt><dd>{DIFFICULTY_LABEL[d.difficulty as 1 | 2 | 3]}</dd></div>
      <div><dt>Tags</dt><dd class="tags">{d.tags.map((t) => <a href={`/browse?q=${encodeURIComponent(t)}`}>{t}</a>)}</dd></div>
    </dl>
  </div>
  <a class="pd-credit" href={AUTHOR.site} target="_blank" rel="noopener">
    <span class="badge" aria-hidden="true">SA</span>
    <span class="txt"><span class="eyebrow">Designed by</span><span class="name">{AUTHOR.name}</span><span class="mono faint">{AUTHOR.city}</span></span>
  </a>
</div>

<style>
  .pd { display: flex; flex-direction: column; gap: 14px; }
  .pd-box .eyebrow { margin-bottom: 8px; }
  dl { margin: 0; display: flex; flex-direction: column; }
  dl div { display: flex; flex-direction: column; gap: 5px; padding: 9px 0; border-top: 1px solid var(--line); font-size: 13px; }
  dt { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); }
  dd { margin: 0; color: var(--ink-2); line-height: 1.45; }
  .swl { display: flex; flex-wrap: wrap; gap: 2px 4px; margin-left: -2px; }
  .sw { display: inline-flex; align-items: center; gap: 5px; min-height: 24px; padding: 2px 5px 2px 2px; border-radius: 5px; transition: background-color var(--t-fast); }
  .sw:hover { background: var(--paper-2); }
  .sw i { width: 14px; height: 14px; border-radius: 4px; box-shadow: inset 0 0 0 1px rgba(0,0,0,.16); flex: none; }
  .sw span { font-size: 12px; color: var(--ink-2); }
  .sw:global(.done) span::after { content: " ✓"; color: var(--accent-text); }
  .tags { display: flex; flex-wrap: wrap; gap: 2px 10px; }
  .tags a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-2); }
  .tags a:hover { color: var(--ink); text-decoration-color: var(--ink); }
  .pd-credit { display: flex; gap: 12px; align-items: center; padding: 12px; border: 1px solid var(--line); border-radius: var(--r-lg); transition: border-color var(--t-fast); }
  .pd-credit:hover { border-color: var(--ink); }
  .badge { flex: none; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--accent-text); color: var(--paper); font: 700 12px/1 var(--mono); }
  .txt { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .txt .eyebrow { font-size: 12px; }
  .name { font-family: var(--display); font-size: 17px; letter-spacing: -0.015em; line-height: 1.1; font-variation-settings: "opsz" 24; }
  .txt .mono { font-size: 12px; }

  .pd.wide { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 260px); gap: 24px; align-items: start; }
  .pd.wide dl div { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 12px; align-items: baseline; }
  @media (max-width: 640px) { .pd.wide { grid-template-columns: minmax(0, 1fr); } }
</style>
