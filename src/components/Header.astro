---
const path = Astro.url.pathname;
const nav = [
  { href: '/start', label: 'Start', match: /^\/(start|kit)/ },
  { href: '/browse', label: 'Browse', match: /^\/(browse|p\/|rooms|platforms|styles|collections)/ },
  { href: '/c', label: 'Sections', match: /^\/c(\/|$)/ },
  { href: '/system', label: 'System', match: /^\/(system|type|themes|icons|motion)/ },
];
const extra = [
  { href: '/agents', label: 'Install' },
  { href: '/collections', label: 'Shelves' },
  { href: '/kit', label: 'Kit' },
  { href: '/sources', label: 'Sources' },
  { href: '/about', label: 'About' },
  { href: '/random', label: 'Surprise' },
];
---
<header class="hdr">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="Design Lounge, home">
      <span class="lamp" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22"><path d="M8 3h8l3 9H5l3-9z" fill="currentColor"/><path d="M12 12v6M8.5 21h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>
      </span>
      <span class="wm">Design <i>Lounge</i></span>
    </a>
    <nav class="nav" aria-label="Primary">
      {nav.map((n) => (
        <a href={n.href} aria-current={n.match.test(path) ? 'page' : undefined}>{n.label}</a>
      ))}
    </nav>
    <div class="tools">
      <a class="tool start" href="/agents" aria-current={path.startsWith('/agents') ? 'page' : undefined}>Install</a>
      <button class="tool search" type="button" data-open-palette aria-label="Search pieces (⌘K)">
        <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
        <span>Search</span><kbd>⌘K</kbd>
      </button>
      <button class="tool" type="button" data-theme-toggle aria-label="Toggle day / night">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </button>
      <button class="tool burger" type="button" data-menu-toggle aria-label="Menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-nav" id="mobile-nav" hidden>
    {nav.map((n) => <a href={n.href} aria-current={n.match.test(path) ? 'page' : undefined}>{n.label}</a>)}
    {extra.map((n) => <a href={n.href}>{n.label}</a>)}
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 86%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
  .bar { height: var(--header-h); display: flex; align-items: center; gap: 28px; }
  .wordmark { display: flex; align-items: baseline; gap: 10px; }
  .lamp { align-self: center; color: var(--accent); transition: transform var(--t-med) var(--ease); }
  .wordmark:hover .lamp { transform: rotate(-8deg); }
  .wm { white-space: nowrap; font-family: var(--display); font-size: 22px; letter-spacing: -0.02em; font-variation-settings: "opsz" 24, "SOFT" 40; }
  .wm i { font-style: italic; }
  .nav { display: flex; gap: 2px; }
  .nav a { padding: 8px 12px; border-radius: var(--r); font-size: 14px; color: var(--ink-2); transition: color var(--t-fast), background-color var(--t-fast); }
  .nav a:hover { color: var(--ink); background: var(--paper-2); }
  .nav a[aria-current="page"] { color: var(--ink); text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 1px; }
  .tools { margin-left: auto; display: flex; align-items: center; gap: 6px; }
  .tool { display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 10px; border-radius: var(--r); color: var(--ink-2); border: 1px solid transparent; transition: color var(--t-fast), border-color var(--t-fast), background-color var(--t-fast); }
  .tool:hover { color: var(--ink); background: var(--paper-2); }
  .tool svg { stroke: currentColor; fill: none; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .start { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; border-color: var(--line); }
  .start { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .start:hover { background: var(--ink); color: var(--paper); opacity: .88; }
  .start[aria-current="page"] { color: var(--paper); border-color: var(--ink); }
  .search { border-color: var(--line); font-size: 13px; padding-right: 8px; }
  .search kbd { margin-left: 4px; }
  .moon { display: none; }
  :global([data-theme="night"]) .moon { display: block; }
  :global([data-theme="night"]) .sun { display: none; }
  .burger { display: none; }
  .mobile-nav { display: none; }
  @media (max-width: 1100px) { .search span, .search kbd { display: none; } .search { padding: 0 8px; } }
  @media (max-width: 820px) {
    .bar { gap: 12px; } .wm { font-size: 20px; }
    .nav, .start, .search span, .search kbd { display: none; }
    .search { padding: 0 8px; }
    .burger { display: inline-flex; }
    .mobile-nav:not([hidden]) { display: flex; flex-direction: column; padding: 8px var(--gutter) 16px; border-top: 1px solid var(--line); }
    .mobile-nav a { padding: 12px 0; font-family: var(--display); font-size: 26px; letter-spacing: -0.02em; border-bottom: 1px solid var(--line); }
    .mobile-nav a:last-child { border-bottom: 0; }
    .mobile-nav a[aria-current="page"] { color: var(--accent); }
  }
</style>
