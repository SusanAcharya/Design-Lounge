---
import { existsSync } from 'node:fs';
import { PLATFORM_META, TYPE_META, pieceUrl, briefUrl, type Piece } from '../lib/pieces';

interface Props { piece: Piece; n: string; index?: number; priority?: boolean; }
const { piece, n, index = 0, priority = false } = Astro.props;
const d = piece.data;
const thumbWebp = new URL(`../../public/thumbs/${piece.id}.webp`, import.meta.url);
const thumbJpg = new URL(`../../public/thumbs/${piece.id}.jpg`, import.meta.url);
const poster = existsSync(thumbWebp) ? `/thumbs/${piece.id}.webp` : existsSync(thumbJpg) ? `/thumbs/${piece.id}.jpg` : '';
const plate = d.palette.slice(0, 4);
---
<article
  class="card reveal"
  data-slug={piece.id}
  data-platform={d.platform}
  data-type={d.type}
  data-category={d.category}
  data-styles={d.styles.join(' ')}
  data-motion={d.motion}
  data-difficulty={d.difficulty}
  data-tags={d.tags.join(' ')}
  data-title={d.title.toLowerCase()}
  data-published={d.published.toISOString().slice(0, 10)}
  data-n={n}
  style={`--d:${Math.min(index, 12) * 40}ms`}
>
  <div class="stage">
    <div class="plate" style={poster ? undefined : `background:${plate[0] ?? 'var(--paper-3)'}`}>
      {poster
        ? <img src={poster} alt="" width="640" height="480" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" />
        : <span class="swatch" aria-hidden="true">{plate.map((c) => <i style={`background:${c}`}></i>)}</span>}
    </div>
    <a class="cover" href={pieceUrl(piece.id)} aria-label={`Open ${d.title}`} tabindex="-1"></a>
  </div>
  <div class="body">
    <div class="meta"><span class="n num">Nº {n}</span><span class="n">{TYPE_META[d.type].singular} · {PLATFORM_META[d.platform].label}</span><span class="swatches" aria-hidden="true">{d.palette.slice(0, 3).map((c) => <i style={`background:${c}`}></i>)}</span></div>
    <h3 class="title"><a href={pieceUrl(piece.id)}>{d.title}</a></h3>
    <p class="summary">{d.summary}</p>
    <button class="brief-copy" type="button" data-copy-brief-url={briefUrl(piece.id)} data-done-label="Copied">Copy brief</button>
  </div>
</article>

<style>
  .body { display: flex; flex-direction: column; gap: 5px; }
  .meta { justify-content: space-between; }
  .meta .swatches { margin-left: auto; }
</style>
