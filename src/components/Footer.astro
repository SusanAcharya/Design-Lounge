---
import { getPieces, AUTHOR } from '../lib/pieces';
import { SHELF_GROUPS } from '../data/collections';
const pieces = await getPieces();
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="wrap">
    <div class="sign">
      <a class="who display" href="/about">{AUTHOR.name}</a>
      <ul class="links mono">
        {AUTHOR.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>)}
        <li><a href={`mailto:${AUTHOR.email}?subject=Design%20Lounge`}>Email ↗</a></li>
      </ul>
    </div>
    <div class="cols">
      <div>
        <p class="eyebrow"><a href="/system">System</a></p>
        <ul>
          <li><a href="/type">Type</a></li>
          <li><a href="/themes">Themes</a></li>
          <li><a href="/icons">Icons</a></li>
          <li><a href="/motion">Motion</a></li>
          <li><a href="/kit">Kit</a></li>
          <li><a href="/start">Start</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow"><a href="/c">Index</a></p>
        <ul>
          <li><a href="/c/hero">Hero</a></li>
          <li><a href="/c/footer">Footer</a></li>
          <li><a href="/c/portfolio">Portfolio</a></li>
          <li><a href="/c/landing">Landing</a></li>
          <li><a href="/c/pricing">Pricing</a></li>
          <li><a href="/c/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow"><a href="/collections">Shelves</a></p>
        <ul>
          {SHELF_GROUPS.map((g) => <li><a href={`/collections#${g.id}`}>{g.label}</a></li>)}
          <li><a href="/browse">Browse</a></li>
          <li><a href="/rooms">Rooms</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Lounge</p>
        <ul>
          <li><a href="/agents">Agents</a></li>
          <li><a href="/guide">Briefs</a></li>
          <li><a href="/sources">Sources</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/random" data-random>Surprise</a></li>
        </ul>
      </div>
    </div>
    <div class="big display" aria-hidden="true">Design <i>Lounge</i></div>
    <div class="legal mono faint">
      <span>© {year} {AUTHOR.name} · Design Lounge · {pieces.length} pieces</span>
      <span><a href={AUTHOR.site}>{AUTHOR.siteLabel}</a></span>
    </div>
  </div>
</footer>

<style>
  .ftr { border-top: 1px solid var(--ink); margin-top: clamp(48px, 8vw, 120px); padding-top: 56px; position: relative; z-index: 1; }
  .sign { display: flex; flex-direction: column; gap: 16px; padding-bottom: 40px; margin-bottom: 32px; border-bottom: 1px solid var(--line); }
  .who { font-size: clamp(40px, 6vw, 72px); line-height: .9; letter-spacing: -0.035em; }
  .who:hover { color: var(--accent); }
  .links { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 18px; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; }
  .links a { border-bottom: 1px solid var(--line-2); padding-bottom: 2px; transition: border-color var(--t-fast); }
  .links a:hover { border-color: var(--ink); }
  .cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .cols .eyebrow { margin-bottom: 14px; }
  .cols li { padding: 5px 0; font-size: 14.5px; }
  .cols li a { border-bottom: 1px solid transparent; transition: border-color var(--t-fast); }
  .cols li a:hover { border-color: var(--ink); }
  .big { font-size: clamp(64px, 14vw, 220px); line-height: 0.85; margin: 64px 0 24px; color: transparent; -webkit-text-stroke: 1px var(--ink-3); user-select: none; letter-spacing: -0.03em; }
  .legal { display: flex; justify-content: space-between; gap: 16px; padding: 16px 0 28px; border-top: 1px solid var(--line); }
  .legal a { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 860px) { .sign { grid-template-columns: 1fr; } .cols { grid-template-columns: 1fr 1fr; } .big { margin-top: 40px; } .legal { flex-direction: column; gap: 6px; } }
</style>
