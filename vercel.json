{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/c", "destination": "/sections", "permanent": true },
    { "source": "/c/:category", "destination": "/sections/:category", "permanent": true }
  ],
  "headers": [
    { "source": "/demo/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/built/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/site.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
